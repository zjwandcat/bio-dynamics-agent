# OpenAI API 配置
# 使用智谱 BigModel 兼容 OpenAI 的端点（参考 https://docs.bigmodel.cn/cn/guide/start/quick-start）
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-5.2

# 服务配置
HOST=0.0.0.0
PORT=8000

# CORS 配置（开发环境允许前端访问）
FRONTEND_URL=http://localhost:3000

# Qdrant 向量库配置
# 方式一：本地 Qdrant（需先用 docker run -p 6333:6333 qdrant/qdrant 启动）
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# 方式二：Qdrant Cloud（推荐，无需本地 Docker）
# 在 https://cloud.qdrant.io/ 创建免费集群，把 Endpoint 和 API Key 填到下面
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=biodynamics_params

# Embedding 模型配置
# 默认复用 OPENAI_BASE_URL / OPENAI_API_KEY；如需独立端点，可覆盖以下两项
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# PubMed E-utilities 联系邮箱（离线建库脚本使用）
NCBI_EMAIL=your-email@example.com
