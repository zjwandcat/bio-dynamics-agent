# =============================================================================
# BioDynamics Agent - 环境变量示例
# 拷贝本文件为 .env 并填入真实值。所有变量均由 app/config.py 读取。
# =============================================================================

# —— LLM（OpenAI 兼容端点）——
# 官方 OpenAI / 智谱 BigModel / DeepSeek / 月之暗面 / Azure OpenAI / 本地 Ollama 均可
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.7-flash

# —— 备用 LLM（主模型失败时自动切换，留空则不启用主备切换）——
BACKUP_API_KEY=
BACKUP_BASE_URL=
BACKUP_MODEL=

# —— 服务 ——
HOST=0.0.0.0
PORT=8000
# CORS 配置（开发环境允许前端访问）
FRONTEND_URL=http://localhost:3000

# —— ChromaDB 向量库（本地持久化，无需 Docker）——
# 默认存放在 backend/data/vector_db，可自定义绝对/相对路径
CHROMA_PERSIST_DIR=./data/vector_db
CHROMA_COLLECTION_NAME=biodynamics_params

# —— Embedding 模型 ——
# EMBEDDING_PROVIDER: openai（调用云端 API，默认）| local（使用 sentence-transformers 本地模型）| openrouter（调用 OpenRouter 兼容端点）
# local 模式可避免云端 Embedding API 余额不足 / 网络问题导致 RAG 不可用
# openrouter 模式可使用免费/低价 embedding 模型，如 nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_PROVIDER=openai
# openai 模式默认 text-embedding-3-small；local 模式默认 sentence-transformers/all-MiniLM-L6-v2；openrouter 模式需显式指定模型名
EMBEDDING_MODEL=text-embedding-3-small
# 如需为 Embedding 单独指定端点（与 LLM 不同），可覆盖以下两项；留空则复用 OPENAI_*
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# —— OpenRouter 专用配置（可选）——
# 用于 Embedding / Rerank 模型，与主 LLM 独立；base_url 默认为 https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter Embedding 模型，例：nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# OpenRouter Rerank 模型，支持逗号分隔多模型，按优先级从左到右
OPENROUTER_RERANK_MODELS=cohere/rerank-4-pro,nvidia/llama-nemotron-rerank-vl-1b-v2:free

# —— SiliconFlow 专用配置（可选）——
# 用于 Embedding / Rerank 模型，与主 LLM 独立；base_url 默认为 https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SiliconFlow Embedding 模型，例：BAAI/bge-m3
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# SiliconFlow Rerank 模型，支持逗号分隔多模型，例：BAAI/bge-reranker-v2-m3
SILICONFLOW_RERANK_MODELS=BAAI/bge-reranker-v2-m3

# —— 讯飞 MaaS 专用配置（可选）——
# 用于 Embedding / Rerank 模型，与主 LLM 独立；key 通常为 appid:api_secret 格式，整体作为 Bearer Token
XFYUN_MAAS_API_KEY=
XFYUN_MAAS_EMBEDDING_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
XFYUN_MAAS_RERANK_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# 讯飞 MaaS Embedding 模型，例：xop3qwen8bembedding
XFYUN_MAAS_EMBEDDING_MODEL=xop3qwen8bembedding
# 讯飞 MaaS Rerank 模型，支持逗号分隔多模型，例：xop3qwen8breranker
XFYUN_MAAS_RERANK_MODELS=xop3qwen8breranker

# —— Rerank 策略 ——
# RERANK_PROVIDER: rule（基于来源/物种/完整性的启发式重排）| model（默认，调用 /rerank API）| hybrid（API 分数 + 启发式规则融合）| openrouter（兼容旧值，等价于 model）
RERANK_PROVIDER=model
# Rerank 多提供商候选优先级，按顺序尝试；默认：讯飞 MaaS > OpenRouter > SiliconFlow
RERANK_PROVIDERS=xfyun,openrouter,siliconflow
# Rerank 模型选择模式：auto（按 RERANK_PROVIDERS 顺序优先可用）| llm（主 LLM 在可用模型中为当前 query 选择）
RERANK_SELECTION_MODE=auto

# —— PubMed E-utilities 联系邮箱（NCBI 要求，用于离线建库/论文搜索）——
NCBI_EMAIL=your-email@example.com
# NCBI API Key（可选，配置后 PubMed 论文搜索限流从 3 req/s 提升至 10 req/s）
# 申请地址：https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# —— RAG 在线数据库自动补充 ——
# 当本地 ChromaDB 检索命中不足时，自动查询 KEGG/Reactome/UniProt/ChEMBL 补充
RAG_ONLINE_FALLBACK=true
# 语义相似度低于此阈值时触发在线补充（0.0-1.0，默认 0.3）
RAG_ONLINE_FALLBACK_THRESHOLD=0.3

# —— MCP（Model Context Protocol）工具端点配置 ——
# MCP_ENABLED=false 可完全跳过 node0 术语查询节点
# 各工具端点留空则自动降级为 LLM 内部知识完成术语查询，不影响主流程
MCP_ENABLED=true
# OpenBioMed Skills（清华AIR×水木分子）：生物医学实体识别与关系抽取
MCP_OPENBIOMED_URL=
# medical-terminologies-mcp：临床术语标准化（ICD-10、SNOMED CT）
MCP_MEDTERM_URL=
# pubmed-search-mcp：PubMed 增强版文献检索
MCP_PUBMED_URL=
# NIH UMLS MCP：本体术语同义词与层级关系
MCP_UMLS_URL=

# =============================================================================
# v4 粗粒度 Feature Flags（Task B.3：生产环境仅暴露这 3 个开关）
# =============================================================================
# 所有 v4 功能默认关闭（false），全 false 时系统行为等价于 v3。
# 启用某层后，该层下属的所有细粒度 hook 均生效。
# 如需精细调试单个 hook，可在 env 中显式设置对应细粒度 flag 覆盖粗粒度开关
# （细粒度 flag 优先级 > 粗粒度；详见 app/config.py 的 _resolve_v4_flag 方法）。
# 细粒度 flag 列表（仅 debug override，不在此暴露）：
#   P1-P4 科学层：V4_ONTOLOGY_AGENT_ENABLED / V4_PATHWAY_GRAPH_ENABLED /
#                 V4_REACTION_IR_ENABLED / V4_REACTION_IR_ADAPTER_ENABLED /
#                 V4_ODE_TEMPLATE_V2_ENABLED / V4_PATHWAY_PLANNER_ENABLED /
#                 V4_PATHWAY_SPECIALIST_ENABLED / V4_CROSSTALK_COORDINATOR_ENABLED
#   P5 验证层：  V4_SBML_GROUNDER_ENABLED / V4_VALIDATION_PYRAMID_ENABLED /
#                 V4_CALIBRATION_AGENT_ENABLED
#   P6 假设层：  V4_HYPOTHESIS_AGENT_ENABLED / V4_DYNAMIC_ROUTING_ENABLED

# V4_SCIENTIFIC_LAYER_ENABLED：启用 P1-P4 科学层（Ontology / Reaction IR /
#   Pathway Graph / ODE Template v2 / Pathway Planner / Pathway Specialist /
#   Cross-talk Coordinator）
V4_SCIENTIFIC_LAYER_ENABLED=false

# V4_VALIDATION_ENABLED：启用 P5 验证层（SBML Grounder / Validation Pyramid /
#   Calibration Agent）
V4_VALIDATION_ENABLED=false

# V4_HYPOTHESIS_ENABLED：启用 P6 假设层（Hypothesis Agent / Dynamic Routing）
V4_HYPOTHESIS_ENABLED=false
