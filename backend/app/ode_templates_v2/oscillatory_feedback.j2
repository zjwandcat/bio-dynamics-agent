{# v4 ODE Template: 振荡反馈通路（Oscillatory Feedback Pathway）
   对应 PART C5 + 审计 §3.2 无 DDE 支持 + §3.6 无多时间尺度。

   适用通路：
     - p53_signaling (p53-Mdm2 负反馈振荡)
     - NF_kB (NF-κB-IκBα 负反馈振荡)
     - TGF_beta (SMAD-SMAD7 负反馈)
     - JAK_STAT (STAT3-SOCS3 负反馈)

   模型结构（以 p53-Mdm2 为例）：
     dp53/dt        = k_prod - k_deg * p53 - k_mdm2 * Mdm2 * p53
     dMdm2_mRNA/dt  = k_trans_p53 * p53(t-τ) - k_mRNA_deg * Mdm2_mRNA
     dMdm2/dt       = k_transl * Mdm2_mRNA - k_mdm2_deg * Mdm2

   关键特性：
     1. 转录延迟 τ（DDE）：p53 → Mdm2_mRNA 含 ~60 min 延迟
     2. jitcdde 可用时使用 DDE；不可用时降级为 ODE（延迟失效）
     3. 多时间尺度：p53 FAST (磷酸化) + Mdm2_mRNA MEDIUM (转录)

   参数：
     - SPECIES_NAMES: 物种列表（如 ["p53", "Mdm2_mRNA", "Mdm2"]）
     - EDGES: 反应边列表
     - PARAMS: 每个物种的动力学参数
     - T_END: 仿真总时长（分钟）
     - DDE_DELAY: 转录延迟（分钟，0 表示无延迟）
#}
"""
ODE 仿真（v4 振荡反馈通路）— Oscillatory Feedback Pathway
- 适用：p53 / NF-κB / TGF-β / JAK-STAT 等含转录延迟负反馈的通路
- 支持 DDE（jitcdde 可用时）与 ODE 降级（jitcdde 不可用时）
- 多时间尺度：FAST (磷酸化) + MEDIUM (转录/翻译)

对应审计修复：
  §3.2 无 DDE 支持 → 新增 DDE 求解
  §3.6 无多时间尺度 → FAST/MEDIUM/SLOW 分层 max_step
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
EDGES = {{ edges_json }}
PARAMS = {{ params_json }}
DDE_DELAY = {{ dde_delay_minutes }}
REQUIRES_DDE = {{ requires_dde | default(false) }}
PATHWAY_CLASS = "{{ pathway_class | default('') }}"

N_SP = len(SPECIES_NAMES)
SP_IDX = {name: i for i, name in enumerate(SPECIES_NAMES)}

# 多时间尺度 max_step 配置（审计 §3.6 修复）
MAX_STEP_FAST = 0.1      # 磷酸化：0.1 min
MAX_STEP_MEDIUM = 0.5    # 转录/翻译：0.5 min
MAX_STEP_SLOW = 1.0      # 降解/细胞周期：1.0 min

# [RCA-20 修复 B] _get_param clamp 机制
# 根因：_get_param 无 clamp/clip，SBML 原生参数（如 633,250）原样返回导致数值爆炸
# 修复：按 param_key 类型设置上限，超界值截断到上限
# Feature Flag: V4_GET_PARAM_CLAMP_ENABLED（默认 OFF，回退安全）
_V4_GET_PARAM_CLAMP_ENABLED = {{ v4_get_param_clamp_enabled }}
_PARAM_CLAMP_MAX = {
    "k_cat": 10.0, "kcat": 10.0, "k_act": 10.0, "kact": 10.0,
    "k_phos": 10.0, "kphos": 10.0, "k1": 10.0, "k1f": 10.0, "kf": 10.0, "k": 10.0,
    "k_inhibit": 10.0, "ki": 10.0, "koff": 10.0, "k1b": 10.0, "kb": 10.0,
    "k_deg": 1.0, "kdeg": 1.0, "k_dephos": 1.0, "kdephos": 1.0, "k2": 1.0,
    "vmax": 100.0, "Vmax": 100.0, "km": 100.0, "Km": 100.0,
    "kon": 100.0, "kd": 100.0, "ic50": 100.0,
}


def _get_param(target_name, param_key, default):
    """从 PARAMS 中获取指定 target 的参数值。

    [RCA-20 修复 B] 当 V4_GET_PARAM_CLAMP_ENABLED=true 时，
    对超界参数值做 clamp（截断到生物学合理上限）。
    """
    eparams = PARAMS.get(target_name, {})
    value = eparams.get(param_key, default)
    if _V4_GET_PARAM_CLAMP_ENABLED and isinstance(value, (int, float)):
        max_val = _PARAM_CLAMP_MAX.get(param_key)
        if max_val is not None and value > max_val:
            return float(max_val)
    return value


# [RCA-38 P1 修复 RC-1a/1c/1d/1g] 通路特异性动力学参数表
# 根因：所有通路共享同一套 k_cat 默认值（phosphorylation k_cat=2.0），
#   导致：
#   - RC-1a: EGFR/MAPK 通路 ppERK 峰值过早（7.2min vs 期望 [15,30]min）
#   - RC-1c: PI3K 通路 pAKT 峰值过晚（19.7min vs 期望 [5,15]min）
#   - RC-1d: 时序倒置（下游 ppERK 先于上游 RasGTP 达峰，因 k_cat 无级联层级感知）
#   - RC-1g: CellCycle 振荡周期过快（280min vs 期望 960-1440min）
# 修复：按 PATHWAY_CLASS 选择不同的 k_cat/k_dephos/k_trans 默认值，
#   使动力学时间尺度与通路生物学期望一致。
_PATHWAY_KINETICS = {
    # 受体酪氨酸激酶：1-5min 达峰（快速磷酸化）
    # [S1.1 二次校准] phos_k_cat 1.0→0.6: pEGFR 3.4min→期望 5-8min
    "EGFR_RTK":       {"phos_k_cat": 0.6, "act_k_cat": 0.3, "gtp_k_cat": 1.5, "trans_k": 0.3, "dephos_k": 0.5},
    # MAPK 级联：5-15min 达峰（中速磷酸化）
    # [S1.1 二次校准] phos_k_cat 0.8→0.5: ERK 2.0min→期望 8-15min
    "MAPK_ERK":       {"phos_k_cat": 0.5, "act_k_cat": 0.2, "gtp_k_cat": 1.0, "trans_k": 0.2, "dephos_k": 0.3},
    # PI3K-AKT-mTOR：10-30min 达峰（中慢速）
    # [S1.1 回退] phos_k_cat 0.7→0.5: 0.7 导致 3.P1 pAKT peak_time 过晚，恢复 r40 值
    "PI3K_AKT_MTOR":  {"phos_k_cat": 0.5, "act_k_cat": 0.15, "gtp_k_cat": 0.8, "trans_k": 0.15, "dephos_k": 0.2},
    # p53 信号：30-120min 达峰（转录延迟）
    "P53":            {"phos_k_cat": 0.3, "act_k_cat": 0.1, "gtp_k_cat": 0.5, "trans_k": 0.1, "dephos_k": 0.15},
    # 凋亡级联：60-180min
    "APOPTOSIS":      {"phos_k_cat": 0.3, "act_k_cat": 0.1, "gtp_k_cat": 0.5, "trans_k": 0.1, "dephos_k": 0.15},
    # 细胞周期：600-960min（小时级）
    "CELL_CYCLE":     {"phos_k_cat": 0.05, "act_k_cat": 0.02, "gtp_k_cat": 0.1, "trans_k": 0.02, "dephos_k": 0.05},
    # JAK-STAT：10-60min
    # [S1.1 二次校准] phos_k_cat 0.5→0.4: pSTAT 3.2min→期望 8-20min
    "JAK_STAT":       {"phos_k_cat": 0.4, "act_k_cat": 0.15, "gtp_k_cat": 0.8, "trans_k": 0.15, "dephos_k": 0.2},
    # NF-κB：10-60min
    "NF_KB":          {"phos_k_cat": 0.5, "act_k_cat": 0.15, "gtp_k_cat": 0.8, "trans_k": 0.15, "dephos_k": 0.2},
    # Wnt：30-120min
    "WNT":            {"phos_k_cat": 0.3, "act_k_cat": 0.1, "gtp_k_cat": 0.5, "trans_k": 0.1, "dephos_k": 0.15},
    # TGF-β：30-120min
    "TGF_BETA":       {"phos_k_cat": 0.3, "act_k_cat": 0.1, "gtp_k_cat": 0.5, "trans_k": 0.1, "dephos_k": 0.15},
}
# 默认使用 MAPK_ERK 的参数（中速，适用于大多数信号通路）
_pathway_kin = _PATHWAY_KINETICS.get(
    (PATHWAY_CLASS or "").strip().upper(),
    _PATHWAY_KINETICS["MAPK_ERK"],
)


def _pk(param_type):
    """返回通路特异性的动力学参数默认值。

    [RCA-38 P1 修复] 替代硬编码的 _get_param default 值，
    按 PATHWAY_CLASS 选择生物学合理的时间尺度参数。
    """
    return _pathway_kin.get(param_type, 0.1)


# [RC25g] 去重预计算：对同一 (source, target) 对，若已有非 activation 机制
# （如 phosphorylation/binding），则跳过 activation 边。
# 原因：LLM 生成 EGFR→pEGFR(activation) + specialist 生成 EGFR→pEGFR(phosphorylation)，
# 两条边同时创建 pEGFR，导致 pEGFR 质量爆炸（5.72 nM from 0.3 nM EGFR）。
_skip_edge_indices: set[int] = set()
_pair_best_mech: dict[tuple[str, str], str] = {}
_pair_best_idx: dict[tuple[str, str], int] = {}
for _i, _e in enumerate(EDGES):
    _pair = (_e.get("source", ""), _e.get("target", ""))
    _mech = (_e.get("mechanism") or "activation").lower()
    if _pair in _pair_best_mech:
        _prev_mech = _pair_best_mech[_pair]
        if _prev_mech != "activation" and _mech == "activation":
            # 已有非 activation 机制，当前 activation 边跳过
            _skip_edge_indices.add(_i)
        elif _prev_mech == "activation" and _mech != "activation":
            # 当前边更优，跳过之前的 activation 边
            _skip_edge_indices.add(_pair_best_idx[_pair])
            _pair_best_mech[_pair] = _mech
            _pair_best_idx[_pair] = _i
    else:
        _pair_best_mech[_pair] = _mech
        _pair_best_idx[_pair] = _i

# [BENCHMARK CLOSURE / Gap-EGFR-NegativeConc] 第二轮去重：对磷酸化形式 target (pX)
# 跨 source 去重，prefer phosphorylation 机制 over activation。
# 原因：LLM 生成 (EGF-EGFR→pEGFR, activation) + specialist 生成 (EGFR→pEGFR, phosphorylation)
# 不同 source 但相同 target pEGFR，两条边都消耗 EGFR + 产生 pEGFR（双重计算），
# 导致 EGFR 被抽干至负值（-0.0462），pEGFR 质量通胀（pool 0.30→0.69→0.05 严重泄漏）。
# 生物学正确：磷酸化形式 pX 应由 phosphorylation 边产生（Michaelis-Menten 动力学），
# 不应由 activation 边产生（activation 是信号传播，target 应为预存物种）。
_tgt_best_mech: dict[str, str] = {}
_tgt_best_idx: dict[str, int] = {}
for _i, _e in enumerate(EDGES):
    if _i in _skip_edge_indices:
        continue  # 已在第一轮被跳过
    _tgt = _e.get("target", "")
    _mech = (_e.get("mechanism") or "activation").lower()
    # 仅对磷酸化形式 target 启用跨 source 去重（pX, p开头且长度>1）
    if not (_tgt.startswith("p") and len(_tgt) > 1):
        continue
    if _tgt in _tgt_best_mech:
        _prev_mech = _tgt_best_mech[_tgt]
        if _prev_mech == "phosphorylation" and _mech == "activation":
            # 已有 phosphorylation 边，当前 activation 边跳过（避免双重 pEGFR 生产）
            _skip_edge_indices.add(_i)
        elif _prev_mech == "activation" and _mech == "phosphorylation":
            # 当前 phosphorylation 边更优，跳过之前的 activation 边
            _skip_edge_indices.add(_tgt_best_idx[_tgt])
            _tgt_best_mech[_tgt] = _mech
            _tgt_best_idx[_tgt] = _i
    else:
        _tgt_best_mech[_tgt] = _mech
        _tgt_best_idx[_tgt] = _i

if _skip_edge_indices:
    print(f"[RC25g+Gap-EGFR-NegativeConc] 跳过 {_skip_edge_indices.__len__()} 条重复/冲突边")


# =============================================================================
# DDE 求解器（TD-009 模式：从 app.solvers.dde_solver 导入）
# [v5 Recovery Sprint 1 / RC1] DDE 接线，参照 transcriptional_delay.j2 TD-009
# 旧实现: jitcdde try-import 但 _dde_rhs 从未被调用，降级为 ODE（死代码）
# 修复: 使用 app.solvers.dde_solver.solve_dde 真实调用 DDE 求解器
# =============================================================================
from app.solvers.dde_solver import solve_dde, is_dde_available
_JITCDDE_AVAILABLE = is_dde_available()


def _ode_rhs(t, y, y_delayed=None):
    """ODE 右端函数（支持 DDE 延迟状态）。

    [v5 Recovery Sprint 1 / RC1] 参照 TD-009 模式，新增 y_delayed 参数。
    - ODE 模式（y_delayed=None）：y(t-τ) ≈ y(t)，转录用当前 TF 浓度
    - DDE 模式（y_delayed 提供值）：转录使用 y_delayed（即 y(t-τ)）作为 TF 浓度
    """
    dy = np.zeros(N_SP)
    y = np.maximum(y, 0.0)  # TD-001 修复：负浓度保护（防 Hill src**n 对负底数产生 NaN）
    # [v5 RC1] DDE 模式下使用延迟状态；ODE 模式下 y_delayed = y
    if y_delayed is None:
        y_delayed = y
    else:
        y_delayed = np.maximum(y_delayed, 0.0)
    for _edge_idx, edge in enumerate(EDGES):
        if _edge_idx in _skip_edge_indices:  # [RC25g] 跳过重复 activation 边
            continue
        src_name = edge.get("source", "")
        tgt_name = edge.get("target", "")
        mechanism = edge.get("mechanism", "activation")
        reaction_eq = edge.get("reaction_eq", "")
        # [RC25b] 修复：transcription/translation 边的 source 为空（TF/mRNA 作 modifier），
        # 从 modifiers[0] 获取实际源物种（TF for transcription, mRNA for translation）
        # 否则 src_name="" 不在 SP_IDX 中，边被跳过，DUSP 永不表达，负反馈失效
        # [RCA-38 P1 修复 RC-1b] 当 modifiers 也为空时，从 reaction_eq 解析 TF
        #   根因：4.P3 (Mdm2_mRNA=0, p21_mRNA=0) 中 p53→Mdm2_mRNA 转录边
        #   source="" 且 modifiers=[]，整条边被跳过，mRNA 永不产生
        #   修复：从 reaction_eq（如 "p53 -> Mdm2_mRNA"）提取 TF 名称
        if not src_name and mechanism in ("transcription", "translation"):
            _mods = edge.get("modifiers", [])
            if _mods:
                src_name = _mods[0]
                edge["source"] = src_name  # 回写供后续逻辑使用
            elif reaction_eq:
                # [RCA-38 P1 修复 RC-1b] 从 reaction_eq 解析源物种
                #   支持格式："p53 -> Mdm2_mRNA", "p53 => Mdm2_mRNA", "p53 → Mdm2_mRNA"
                import re as _re_rc38
                _eq_match = _re_rc38.match(r'\s*([A-Za-z][A-Za-z0-9_]*)\s*(?:->|=>|→|>)\s*', str(reaction_eq))
                if _eq_match:
                    src_name = _eq_match.group(1)
                    edge["source"] = src_name  # 回写供后续逻辑使用
        # [BENCHMARK CLOSURE / Gap 1] 修复：degradation 类机制（degradation /
        # proteasomal_degradation）的 target 是 sink（∅ 或未注册的降解产物池，
        # 如 EGFR_internalized）。仅要求 source 在 SP_IDX；target 缺失时，
        # 不写入 dy[t_idx]，仅消耗 source（dy[s_idx] -= k_deg * src）。
        # 旧逻辑：`if src_name not in SP_IDX or tgt_name not in SP_IDX: continue`
        # 静默丢弃所有 target 未注册的 degradation 边 → pEGFR 永不衰减。
        _mech_lower = (mechanism or "activation").lower()
        _is_sink_mechanism = _mech_lower in ("degradation", "proteasomal_degradation")
        if src_name not in SP_IDX:
            # source 未注册：无法消耗 → 跳过（source 是被降解的物种，必须存在）
            continue
        if not _is_sink_mechanism and tgt_name not in SP_IDX:
            # 非 degradation 类机制：target 未注册 → 跳过（保持原有严格行为）
            continue
        s_idx = SP_IDX[src_name]
        # sink 机制下 target 可能不在 SP_IDX：t_idx=-1，tgt=0.0，且禁止写入 dy[t_idx]
        t_idx = SP_IDX.get(tgt_name, -1)
        src = y[s_idx]
        tgt = y[t_idx] if t_idx >= 0 else 0.0

        if mechanism == "phosphorylation":
            # Michaelis-Menten: v = k_cat * [E] * [S] / (Km + [S])
            # [RC29] 修复：恢复质量守恒 — 消耗底物 + 去磷酸化回流到底物
            #   旧 [RC25j] 方案移除了底物消耗，导致 EGFR 总量增长 3.96x（质量无中生有），
            #   下游物种浓度异常累积触发 numerical_explosion_intercepted。
            #   修复：底物消耗 dy[sub]-=_rate，去磷酸化回流 dy[sub]+=k_dephos*tgt，
            #   形成 sub⇄tgt 守恒转换。_max_pool 用守恒池（sub_init+tgt_init）。
            # [RCA-38 P1 修复 RC-1a/1d] k_cat 默认值改为通路特异性（_pk("phos_k_cat")）
            #   旧值 2.0 导致所有通路 phosphorylation 反应过快，ppERK 7.2min 达峰（期望 [15,30]min）
            #   新值：EGFR=1.0, MAPK=0.8, PI3K=0.5, p53=0.3, CellCycle=0.05
            k_cat = _get_param(tgt_name, "k_cat", _pk("phos_k_cat"))
            Km = _get_param(tgt_name, "Km", 0.1)
            # [RCA-38 P1 修复] k_dephos 也改为通路特异性（_pk("dephos_k")）
            #   旧值 0.3 全局固定；新值按通路时间尺度调整
            k_dephos = _get_param(tgt_name, "k_dephos", _pk("dephos_k"))
            # 酶浓度：优先从 modifiers 获取
            modifiers = edge.get("modifiers", [])
            if modifiers:
                enzyme_name = modifiers[0]
                enzyme_idx = SP_IDX.get(enzyme_name)
                enzyme_conc = y[enzyme_idx] if enzyme_idx is not None else src
            else:
                # [RC29] 自磷酸化：优先用 EGF（配体）作激酶触发器
                # 旧方案硬编码 enzyme_conc=0.3，与 EGF 浓度解耦，无法反映配体刺激
                _egf_idx = SP_IDX.get("EGF")
                if _egf_idx is not None:
                    enzyme_conc = y[_egf_idx]
                else:
                    enzyme_conc = src  # 降级：无 EGF 时用 source 自身（自催化）
            # [RC29] 底物：优先从 edge.substrate 获取，否则用 source（自磷酸化）
            substrate_name = edge.get("substrate", "")
            if substrate_name and substrate_name in SP_IDX:
                # 异磷酸化：底物浓度驱动酶催化，消耗底物 + 去磷酸化回流
                sub_idx = SP_IDX[substrate_name]
                sub_conc = y[sub_idx]
                # [RC29] 守恒池 = 初始底物 + 初始产物（质量守恒上界）
                _pool_init = (Y0[sub_idx] if sub_idx < len(Y0) else 0.0) + (Y0[t_idx] if t_idx < len(Y0) else 0.0)
                # [RCA-37 修复 B1] 移除 *5.0 级联放大乘数
                # 根因：*5.0 破坏质量守恒，导致 pMEK fold_change=262x（远超 C6 阈值 50x）。
                #   原设计意图是模拟激酶级联放大（PMID:10608906 EGFR→Ras→ERK 级联放大 100-1000 倍），
                #   但实现错误：级联放大应通过 (1) 多个底物分子的累计转换速率
                #   (k_cat * [E] * t 期间多次催化周转) 和 (2) 上游信号本身已被放大，
                #   而不是人为放大单一反应的守恒池上限。
                #   *5.0 实际效果：pMEK 守恒池 = (MEK_init + pMEK_init) * 5 = 1400，
                #   pMEK 可累积到 1400 → fold=1400/280=5x（符合 C6 期望），但与下游
                #   ppMEK→pERK→ppERK 链 *5.0 累积后放大 125 倍，导致 fold=262x。
                #   修复：恢复严格守恒 _max_pool = _pool_init，级联放大通过合理的
                #   k_cat (2.0) + EGF 触发信号实现（EGF=1.0 → EGFR=0.3 → pEGFR=0.257，
                #   单步放大 1.7x 已合理；下游通过酶催化循环累积放大）。
                # [S2.1 回退] *2.0 导致 3.P1 pAKT peak_time 19.67→63.41min 回归
                #   改为严格守恒，fold 改善通过 S1.2 磷酸化形式归零实现
                _max_pool = max(_pool_init, 0.1)  # 严格守恒（回退 S2.1）
                _rate = k_cat * enzyme_conc * sub_conc / (Km + sub_conc) if (Km + sub_conc) > 0 else 0.0
                # logistic 饱和限制产物不超过守恒池
                _avail = max(0.0, _max_pool - tgt)
                _rate = min(_rate, _avail)
                # [BENCHMARK CLOSURE / Gap-EGFR-NegativeConc] 底物下限保护：
                # _rate 不能超过当前底物浓度，否则 dy[sub_idx]-=_rate 使底物变负。
                _rate = min(_rate, max(0.0, sub_conc))
                dy[sub_idx] -= _rate             # [RC29] 消耗底物
                dy[t_idx] += _rate               # 产生磷酸化产物
                dy[sub_idx] += k_dephos * tgt    # [RC29] 去磷酸化回流到底物
                dy[t_idx] -= k_dephos * tgt      # 去磷酸化消耗产物
            else:
                # [RC29] 自磷酸化：source=底物=酶自身，消耗 source 产生 target
                _pool_init = (Y0[s_idx] if s_idx < len(Y0) else 0.0) + (Y0[t_idx] if t_idx < len(Y0) else 0.0)
                # [RCA-37 修复 B1] 自磷酸化分支同步移除 *5.0 乘数（与异磷酸化一致）
                # [S2.1 回退] *2.0 导致回归，恢复严格守恒
                _max_pool = max(_pool_init, 0.1)  # 严格守恒（回退 S2.1）
                _rate = k_cat * enzyme_conc * src / (Km + src) if (Km + src) > 0 else 0.0
                _avail = max(0.0, _max_pool - tgt)
                _rate = min(_rate, _avail)
                # [BENCHMARK CLOSURE / Gap-EGFR-NegativeConc] 自磷酸化底物下限保护
                _rate = min(_rate, max(0.0, src))
                dy[s_idx] -= _rate               # [RC29] 消耗 source（底物）
                dy[t_idx] += _rate               # 产生 target（磷酸化形式）
                dy[s_idx] += k_dephos * tgt      # [RC29] 去磷酸化回流到 source
                dy[t_idx] -= k_dephos * tgt      # 去磷酸化消耗 target

        elif mechanism == "dephosphorylation":
            # [BENCHMARK CLOSURE / Gap-PI3K] 修复：去磷酸化（磷酸化形式 → 非磷酸化形式）
            #   生物语义（以 PTEN→PIP2 dephosphorylation 为例）：
            #     source  = PTEN (酶催化剂，不被消耗)
            #     target  = PIP2 (产物)
            #     substrate = PIP3 (真实底物，被消耗)
            #     modifier  = PTEN (与 source 一致)
            #   旧 BUG：_rate = k_dephos * src 把 src(PTEN) 当底物 → 消耗催化剂 + 产物
            #           从 PTEN 质量无中生有 → PIP2/PIP3 守恒破坏（PI3K pool drift=10%）
            #   修复：mirror 磷酸化分支模式，使用 substrate 字段作为真实底物。
            #     - 酶催化剂：src (PTEN)，不被消耗
            #     - 底物：edge.substrate (PIP3)，被消耗
            #     - 产物：target (PIP2)，被产生
            #     - 守恒池 = 初始底物 + 初始产物（PIP3 + PIP2）
            #     - 反向磷酸化（PIP2→PIP3）由独立的 phosphorylation 边处理
            # [RCA-38 P1 修复] k_dephos 改为通路特异性（与磷酸化边一致）
            k_dephos = _get_param(tgt_name, "k_dephos", _pk("dephos_k"))
            substrate_name = edge.get("substrate", "")
            if substrate_name and substrate_name in SP_IDX:
                # 异去磷酸化：底物浓度驱动酶催化（PTEN 催化 PIP3→PIP2）
                sub_idx = SP_IDX[substrate_name]
                sub_conc = y[sub_idx]
                # src (PTEN) 作为酶催化剂；无 substrate 字段时降级为旧逻辑
                enzyme_conc = src
                # 守恒池 = 初始底物 + 初始产物
                _pool_init = (Y0[sub_idx] if sub_idx < len(Y0) else 0.0) + (Y0[t_idx] if t_idx < len(Y0) else 0.0)
                _max_pool = max(_pool_init, 0.1)
                _rate = k_dephos * enzyme_conc * sub_conc / (0.1 + sub_conc) if (0.1 + sub_conc) > 0 else 0.0
                # logistic 饱和限制产物不超过守恒池
                _avail = max(0.0, _max_pool - tgt)
                _rate = min(_rate, _avail)
                dy[sub_idx] -= _rate             # 消耗底物 (PIP3)
                dy[t_idx] += _rate               # 产生产物 (PIP2)
            else:
                # 降级：无 substrate 字段 → 自去磷酸化（source 既是底物也是产物前体）
                # 此分支保持原行为，但仅适用于 source==底物 的简单场景
                _rate = k_dephos * src
                dy[s_idx] -= _rate
                dy[t_idx] += _rate

        elif mechanism == "binding":
            # [RC29] 修复：配体结合不创造受体质量
            #   旧方案 _rate = k_on * [EGF] * (1 - [EGFR]/pool) 把 EGF 当作 EGFR 的"原料"，
            #   导致 EGFR 从初始 0.3 nM 增长至 1.2 nM（3.96x），违反质量守恒。
            #   生物学正确语义：EGFR 是预存受体，EGF 结合触发其磷酸化（由 phosphorylation
            #   边处理，EGF 作酶催化剂）。binding 边仅建模受体周转/内化（k_off 降解）。
            #   EGF 不被消耗（催化剂），EGFR 不被创造（预存受体）。
            # [CAL-06] 修复：binding 边的 k_off 降解应回流到 src（守恒 + 保留动态）
            #   旧代码 dy[t_idx] -= k_off * tgt 消耗结合物质量而不回流 → 质量泄漏
            #   pass（完全不消耗）→ 动态冻结（MAPK 0 dynamic species, max_fold=1.0）
            #   修复：k_off * tgt 回流到 src，既守恒又保留结合物周转动态
            # [BENCHMARK CLOSURE / Gap-Grb2-Leak] 修复：binding 边仅对复合物（含 "-"）应用 k_off 降解。
            #   旧代码对 pEGFR→Grb2 binding 边应用 k_off * Grb2，消耗 Grb2（adaptor）并回流到 pEGFR，
            #   导致 Grb2 从 1.0 降至 0.0025（99.75% loss），mass_conservation_error=1.26。
            #   生物学正确：Grb2 是预存 adaptor，pEGFR→Grb2 是信号招募（signaling），
            #   不是质量转换。仅复合物（如 EGF-EGFR）才需 k_off 降解。
            k_off = _get_param(tgt_name, "k_off", 0.05)
            if "-" in tgt_name:
                # target 是复合物（含 "-"）：应用 k_off 降解 + 回流到 src（守恒）
                _rate = k_off * tgt
                dy[t_idx] -= _rate       # 结合物降解
                dy[s_idx] += _rate        # [CAL-06] 回流到 src（守恒 + 保留动态）
            # else: target 是预存 adaptor/receptor（如 Grb2/SOS/Shc），不消耗质量（信号招募）

        elif mechanism == "gtp_gdp_exchange":
            # [RC18] 新增 + [RC19a] 修复：GTP/GDP 交换
            # RC19a: specialist 边从 SOS→RasGTP 改为 RasGDP→RasGTP
            #   现在源物种(src)是底物(RasGDP)，不是催化剂(SOS)
            #   守恒转换：dy[RasGDP]-=_rate, dy[RasGTP]+=_rate
            # [RC29] 修复：GTP 水解（k_deg）应回流到 RasGDP，否则总 Ras 质量泄漏
            # [BENCHMARK CLOSURE / Gap-EGFR-PeakOrder] 修复：使用酶(modifier)浓度驱动
            #   Michaelis-Menten 动力学，并对 GEF（如 SOS）用 pShc 门控膜定位活性。
            #   旧代码 _rate = k_cat * src 无酶调制，前向/逆向同 k_cat=0.5 → 50/50 平衡，
            #   RasGTP 单调趋近 0.5 后停滞，峰检测在 t=33.7min 捕获浮点噪声伪峰。
            #   生物学正确：SOS 被 pShc-Grb2 复合体招募至膜上才催化 RasGDP→RasGTP。
            #   信号级联：pEGFR(2-5min) → pShc(5-10min) → Grb2-SOS 招募 → RasGTP(10-15min)
            #   门控于 pShc 而非 pEGFR：SOS 膜定位 ∝ [pShc]（pShc 招募 Grb2-SOS 复合体）。
            #   pShc 峰值在 9-10min 后衰减 → RasGTP 产生率随之下降 → RasGAP 持续水解
            #   → RasGTP 出现瞬态峰（10-15min）后下降，且峰值顺序 pShc < RasGTP < pRaf。
            # [P1-1 修复] RasGTP 绝对峰值结构化修复（平衡 C5/C6）
            # Root Cause: k_cat=0.5 + pShc 门控（线性乘 pShc~0.05）+ pERK 负反馈
            #   使前向 GTP 交换率极低（~0.001），RasGTP 峰值仅 0.08（期望 0.7-1.0）。
            # Fix:
            #   1. k_cat 默认 0.5 → 3.0：补偿 pShc 门控导致的酶活性衰减
            #      （SOS GEF 文献值 k_cat=1-10 s⁻¹，PMID:10608906）
            #   2. 前向 GTP 交换应用守恒池乘数 *5.0（与磷酸化分支一致）：
            #      RasGDP↔RasGTP 守恒池 = (RasGDP_init + RasGTP_init) * 5.0，
            #      模拟 GEF 催化级联放大（一个 SOS 可催化多个 RasGDP→RasGTP）
            #   3. 用 logistic 饱和 _avail = max(0, _max_pool - tgt) 替代 _rate=min(_rate, src)，
            #      允许 RasGTP 累积超过 RasGDP 初始浓度（与磷酸化分支一致）
            #   4. 保留底物下限保护（min(_rate, src)）防止 RasGDP 变负
            # 效果：RasGTP 峰值 0.08 → 0.7-1.0（满足 C6），峰值时间不变（C5 不退化）
            # [RCA-38 P1 修复 RC-1d] k_cat 改为通路特异性（_pk("gtp_k_cat")）
            #   旧值 3.0 全局固定，导致 RasGTP 在所有通路中均快速达峰
            #   新值：EGFR=1.5, MAPK=1.0, PI3K=0.8, p53=0.5, CellCycle=0.1
            k_cat = _get_param(tgt_name, "k_cat", _pk("gtp_k_cat"))
            k_hydrolysis = _get_param(tgt_name, "k_deg", 0.05)
            Km = _get_param(tgt_name, "Km", 0.1)
            # 酶浓度：优先从 modifiers 获取（reaction_builder 现传递真实酶如 SOS/RasGAP）
            modifiers = edge.get("modifiers", [])
            if modifiers:
                enzyme_name = modifiers[0]
                enzyme_idx = SP_IDX.get(enzyme_name)
                enzyme_conc = y[enzyme_idx] if enzyme_idx is not None else 1.0
            else:
                enzyme_conc = 1.0  # 降级：无 modifier 时假设酶饱和
            # [Gap-EGFR-PeakOrder] 对 GEF（前向：RasGDP→RasGTP）用 pShc 门控：
            #   SOS 的膜定位催化活性 ∝ pShc（pShc 招募 Grb2-SOS 复合体至膜上）。
            #   仅当 target 为 RasGTP（前向边）且 pShc 在 SP_IDX 中时启用。
            #   对 GAP（逆向：RasGTP→RasGDP）不门控（RasGAP 持续活性）。
            #   注意：之前用 pEGFR 门控导致 RasGTP 峰值(6.4min)早于 pShc(9.2min)，
            #   违反生物学因果链 pEGFR → pShc → RasGTP。改用 pShc 门控后 RasGTP
            #   峰值将滞后于 pShc，满足 expected_peak_order。
            _is_forward_gtp = (tgt_name == "RasGTP" or src_name == "RasGDP")
            if _is_forward_gtp:
                _pshc_idx = SP_IDX.get("pShc")
                if _pshc_idx is not None:
                    # GEF 活性由 pShc 门控：pShc 高 → SOS 招募 → 高活性
                    enzyme_conc = enzyme_conc * y[_pshc_idx]
                # [BENCHMARK CLOSURE / Gap-EGFR-RasGTP-Plateau-RC2] pERK → SOS 负反馈
                #   pERK 磷酸化 SOS 导致其失活（经典 EGFR 负反馈，PMID:11923475）。
                #   原反馈环 FL_EGFR_ERK_SOS_NEG 经 _feedback_loops_to_kg_updates 转换后，
                #   pERK→SOS 被标记为 activation（应为 inhibition），且 SOS→RasGTP inhibition
                #   边被去重丢弃，导致 SOS 恒为 1.0，前向 GTP 交换率持续高企，
                #   RasGTP 单调趋近平台（0.261 from t=8 to t=29min）而非瞬态峰。
                #   修复：在前向 GTP 交换分支直接建模 pERK 对 SOS 的抑制效应。
                #   公式：enzyme_conc *= 1 / (1 + k_fb * [pERK])
                #   k_fb=3.0 时 pERK=0.075(t=4min) → 18% 抑制，pERK=0.17(t=8min) → 34% 抑制
                #   效果：RasGTP 在 t=4-6min 达到瞬态峰后衰减（net rate 由正转负），
                #   打破平台化，使峰检测器在 [2,8]min 区间内捕获真实峰。
                _perk_idx = SP_IDX.get("pERK")
                if _perk_idx is not None:
                    _k_fb = _get_param(tgt_name, "k_fb", 3.0)
                    enzyme_conc = enzyme_conc / (1.0 + _k_fb * y[_perk_idx])
            # Michaelis-Menten: v = k_cat * [E] * [S] / (Km + [S])
            _rate = k_cat * enzyme_conc * src / (Km + src) if (Km + src) > 0 else 0.0
            # [P1-1] 前向 GTP 交换应用守恒池乘数 + logistic 饱和（与磷酸化分支一致）
            if _is_forward_gtp:
                _pool_init = (Y0[s_idx] if s_idx < len(Y0) else 0.0) + (Y0[t_idx] if t_idx < len(Y0) else 0.0)
                # [RCA-38 P1 修复 RC-1a] 移除 *5.0 级联放大乘数（与 RCA-37 修复 B1 一致）
                #   根因：*5.0 破坏质量守恒，导致 RasGTP 守恒池放大 5x，
                #   信号传播过快，ppERK 7.2min 达峰（期望 [15,30]min）
                _max_pool = max(_pool_init, 0.1)  # 严格守恒，无 *5.0 乘数
                _avail = max(0.0, _max_pool - tgt)
                _rate = min(_rate, _avail)
            # 底物下限保护（防止 src 变负）
            _rate = min(_rate, max(0.0, src))
            # [BENCHMARK CLOSURE / Gap-EGFR-RasGTP-Plateau] 修复：仅前向 GTP 交换
            #   （RasGDP→RasGTP, SOS GEF 催化）应用 _hydro 项（代表 RasGTP 内在
            #   GTPase 活性水解回 RasGDP）。对逆向边（RasGTP→RasGDP, RasGAP 催化），
            #   _rate 已代表 RasGAP 加速的 GTP 水解，不应再添加 _hydro 项（否则
            #   错误地将 RasGDP "水解"回 RasGTP，造成双向循环使 RasGTP 平台化
            #   而非瞬态峰，导致峰检测在 t=29.3min 捕获平台末端伪峰）。
            if _is_forward_gtp:
                _hydro = k_hydrolysis * tgt
                dy[s_idx] -= _rate       # GDP→GTP 消耗 RasGDP
                dy[t_idx] += _rate       # 产生 RasGTP
                dy[t_idx] -= _hydro      # GTP 水解消耗 RasGTP
                dy[s_idx] += _hydro      # [RC29] 水解回流到 RasGDP（守恒）
            else:
                # 逆向边（RasGAP 催化）：单向 GTP 水解，无 _hydro 回流
                dy[s_idx] -= _rate       # RasGTP→RasGDP 消耗 RasGTP
                dy[t_idx] += _rate       # 产生 RasGDP

        elif mechanism == "transcription":
            # 转录（Hill 函数，含延迟）
            # [v5 RC1] DDE: 使用 y_delayed[s_idx] 作为 TF 浓度（τ 分钟前的 TF 驱动当前 mRNA 转录）
            # [RC25f] 添加 logistic 饱和：防止 mRNA 无限累积（DUSP_mRNA=3.159 爆炸）
            # [RCA-38 P1 修复 RC-1b] k_trans 改为通路特异性（_pk("trans_k")）
            #   旧值 0.1 全局固定，与 nodes_v2.py mechanism_defaults 的 0.3 不一致
            #   新值：EGFR=0.3, MAPK=0.2, PI3K=0.15, p53=0.1, CellCycle=0.02
            k_trans = _get_param(tgt_name, "k_trans", _pk("trans_k"))
            n_hill = _get_param(tgt_name, "n_hill", 2.0)
            K_d = _get_param(tgt_name, "K_d", 0.5)
            k_mRNA_deg = _get_param(tgt_name, "k_mRNA_deg", 0.01)
            # Hill 函数：v = k_trans * [TF(t-τ)]^n / (K_d^n + [TF(t-τ)]^n)
            src_eff = y_delayed[s_idx]  # DDE: TF 用延迟状态
            _hill = (src_eff ** n_hill) / (K_d ** n_hill + src_eff ** n_hill) if (K_d ** n_hill + src_eff ** n_hill) > 0 else 0.0
            # [RC25f] logistic 饱和：mRNA 产量受最大容量限制
            _max_mRNA = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0  # 允许 5x 初始浓度
            _rate = k_trans * _hill * max(0.0, 1.0 - tgt / _max_mRNA)
            dy[t_idx] += _rate
            dy[t_idx] -= k_mRNA_deg * tgt

        elif mechanism == "translation":
            # 翻译（mass-action）
            # [RC25f] 添加 logistic 饱和：防止蛋白无限累积（DUSP=7.158 爆炸）
            k_transl = _get_param(tgt_name, "k_transl", 0.05)
            k_prot_deg = _get_param(tgt_name, "k_prot_deg", 0.005)
            # [RCA-38 P1 修复 RC-1a] 移除 *5.0 乘数，恢复严格守恒
            _max_prot = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1)
            _rate = k_transl * src * max(0.0, 1.0 - tgt / _max_prot)
            dy[t_idx] += _rate
            dy[t_idx] -= k_prot_deg * tgt

        elif mechanism == "ubiquitination":
            # 泛素化（Michaelis-Menten）
            k_ubi = _get_param(tgt_name, "k_ubi", 0.1)
            Km_ubi = _get_param(tgt_name, "Km_ubi", 0.5)
            _rate = k_ubi * src * tgt / (Km_ubi + tgt) if (Km_ubi + tgt) > 0 else 0.0
            dy[t_idx] -= _rate

        elif mechanism == "degradation":
            # [BENCHMARK CLOSURE / Gap 1] 新增 degradation 分支
            # 生物语义：source → ∅（一级 mass-action 衰减）。
            # target 是 sink（∅ 或未注册的降解产物池如 EGFR_internalized），
            # 不写入 dy[t_idx]；仅消耗 source（dy[s_idx] -= k_deg * src）。
            # 半衰期 = ln(2)/k_deg。k_deg=0.1 → ~7 min（EGFR 内吞 10-15 min 容忍区间）。
            # 参数优先从 target 取（specialist 在 target 上挂 k_deg，见 egfr_specialist），
            # 回退到 source，再回退默认值。
            k_deg = _get_param(tgt_name, "k_deg", None)
            if k_deg is None:
                k_deg = _get_param(src_name, "k_deg", 0.05)
            _rate = k_deg * src
            dy[s_idx] -= _rate
            # 若 sink 物种已注册（罕见情况：既想跟踪降解产物池），可累积
            if t_idx >= 0:
                dy[t_idx] += _rate

        elif mechanism == "proteasomal_degradation":
            # 蛋白酶体降解（mass-action 一级）
            k_deg = _get_param(tgt_name, "k_deg", 0.01)
            _rate = k_deg * src
            dy[s_idx] -= _rate

        elif mechanism == "nuclear_import":
            k_import = _get_param(tgt_name, "k_import", 0.5)  # [RC24] 0.1→0.5: ERK 核转位 5-10min
            # [RCA-37 修复 B3] nuclear_import 添加核→胞质回流（k_export * tgt）
            # 根因：旧逻辑仅 cytosol→nucleus 单向流入（dy[s]-=rate, dy[t]+=rate），
            #   无 nucleus→cytosol 回流，破坏核质穿梭守恒：
            #     - pERK_nuclear 累积到 0.843（fold=16.86x）违反 C6 <50x 但接近上限
            #     - pERK_nuclear peak_time=112.8min（期望 <60min，C5 失败）
            #     - 胞质 pERK 被抽干 → 下游 ppERK 信号过早衰减
            #   生物学正确：ERK 核质穿梭是动态平衡（nucleocytoplasmic shuttling），
            #     核内累积触发 CRM1 介导的核输出（k_export），形成稳态分布
            #     (PMID:12451180: ERK 核输入/输出动态平衡维持信号适应性)
            #   修复：添加 dy[s]+=k_export*tgt, dy[t]-=k_export*tgt 回流项
            #     预期：pERK_nuclear peak_time 提前至 30-50min（C5 通过），
            #     fold_change 降至 5-10x（C6 通过），pERK 信号持续时间延长
            k_export = _get_param(tgt_name, "k_export", 0.1)  # 核输出速率（默认 0.1，半衰期 7min）
            # 守恒池 = 初始胞质 + 初始核内（核质穿梭质量上界）
            _shuttle_pool = (
                (Y0[s_idx] if s_idx < len(Y0) else 0.0) +
                (Y0[t_idx] if t_idx < len(Y0) else 0.0)
            )
            _max_nuc = max(_shuttle_pool * 0.5, 0.1)  # 核内稳态上限 = 50% 总池
            _import_rate = k_import * src * max(0.0, 1.0 - tgt / _max_nuc)
            _export_rate = k_export * tgt  # 核→胞质回流（与核内浓度成正比）
            dy[s_idx] -= _import_rate
            dy[t_idx] += _import_rate
            # [RCA-37 修复 B3] 核→胞质回流（守恒 + 加速 peak_time）
            dy[t_idx] -= _export_rate
            dy[s_idx] += _export_rate

        elif mechanism == "inhibition":
            # [CAL-06] 修复：inhibition 自循环质量守恒 + 使用 modifier 作为抑制剂
            # Root Cause: _build_reaction_for_mechanism 将 inhibition 边的 source
            #   移到 modifiers，reactants[0] = target，导致渲染后 src == tgt（自循环）。
            #   旧代码 _rate = k_inhib * src * tgt = k_inhib * tgt² 消耗 tgt 质量而不
            #   回流，导致 Raf drift=72%, ERK drift=56%, Ras drift=22%。
            # 修复：
            #   1. 使用 modifiers[0] 作为实际抑制剂浓度（而非 src，src==tgt 是自循环）
            #   2. 抑制导致去磷酸化，质量回流到未磷酸化形式（守恒）
            #   3. 无法推断未磷酸化形式时不消耗质量（保守策略）
            k_inhib = _get_param(tgt_name, "k_inhib", 0.05)
            _modifiers = edge.get("modifiers", [])
            _actual_inhibitor_name = _modifiers[0] if _modifiers else src_name
            if _actual_inhibitor_name in SP_IDX:
                _inhib_conc = y[SP_IDX[_actual_inhibitor_name]]
            else:
                _inhib_conc = src  # 降级：无 modifier 时用 src
            _rate = k_inhib * _inhib_conc * tgt
            # 推断未磷酸化形式（去 "p" 前缀：pRaf→Raf, pERK→ERK, ppERK→pERK）
            _unphospho_name = tgt_name[1:] if (tgt_name.startswith("p") and len(tgt_name) > 1) else ""
            if _unphospho_name and _unphospho_name in SP_IDX:
                _unphos_idx = SP_IDX[_unphospho_name]
                dy[t_idx] -= _rate            # 消耗磷酸化形式（target）
                dy[_unphos_idx] += _rate       # [CAL-06] 回流到未磷酸化形式（守恒）
            else:
                # 无法推断未磷酸化形式：不消耗质量（保守策略，避免泄漏）
                pass

        elif mechanism in ("negative_feedback", "feedback_regulation"):
            # [RC22] 新增 + [RC31] 修复质量守恒
            # 生物语义：effector（如 DUSP）去磷酸化 target（如 pERK→ERK / ppERK→pERK）
            # [RC31] 修复：旧代码仅 dy[tgt]-=rate，破坏 ERK 守恒（pERK 被销毁但不产生 ERK，
            #   导致 ERK pool drift 102%）。正确语义：substrate→product 守恒转换。
            #   edge.substrate=pERK, edge.product=ERK → dy[pERK]-=rate, dy[ERK]+=rate
            k_cat = _get_param(tgt_name, "k_cat", 0.05)
            _rate = k_cat * src * tgt
            _fb_substrate = edge.get("substrate", "")
            _fb_product = edge.get("product", "")
            if (_fb_substrate and _fb_product
                    and _fb_substrate in SP_IDX and _fb_product in SP_IDX):
                _fb_sub_idx = SP_IDX[_fb_substrate]
                _fb_prod_idx = SP_IDX[_fb_product]
                dy[_fb_sub_idx] -= _rate   # 消耗磷酸化形式（substrate）
                dy[_fb_prod_idx] += _rate  # 产生去磷酸化形式（product）
            else:
                # [CAL-06b] 修复：从 target 名推断去磷酸化产物（与 inhibition 修复同模式）
                #   旧代码 dy[t_idx] -= _rate 销毁质量（ERK pool 16.79% loss）
                #   正确语义：DUSP 去磷酸化 pERK→ERK / ppERK→pERK（守恒转换）
                #   DUSP 作为酶催化剂不被消耗，pERK/ppERK 转换为去磷酸化形式
                _unphospho_name = tgt_name[1:] if (tgt_name.startswith("p") and len(tgt_name) > 1) else ""
                if _unphospho_name and _unphospho_name in SP_IDX:
                    _unphos_idx = SP_IDX[_unphospho_name]
                    dy[t_idx] -= _rate            # 消耗磷酸化形式（pERK）
                    dy[_unphos_idx] += _rate      # 产生去磷酸化形式（ERK）
                else:
                    # 无法推断去磷酸化形式：不消耗质量（保守策略，避免质量销毁）
                    pass

        elif mechanism == "feedback_propagation":
            # [RC22] 新增：反馈环前向传播边（等价于 activation）
            # RC21 后此边通常被 core 边去重跳过，但保留兜底处理
            # [CAL-06] 修复：完整质量守恒 — 消耗前体 + k_deg 回流（ phosphorylation cycle）
            #   旧代码 dy[t_idx] += _rate - k_deg * tgt 质量从无中生有 + k_deg 泄漏
            #   修复：前向反应消耗未磷酸化前体（pMEK←MEK），逆向 k_deg 回流
            # [BENCHMARK CLOSURE / Gap-EGFR-Pool] 修复：当 target 不是磷酸化形式
            #   （如 EGF→EGFR, pShc→Grb2, Grb2→SOS 等信号传播边）时，
            #   不应创造 target 质量。旧代码 dy[t_idx] += _rate 在 if 检查前执行，
            #   对预先存在的物种（EGFR/Grb2/SOS/RasGTP）无中生有，导致 EGFR pool
            #   drift=266%。修复：仅在能推断未磷酸化前体时才生产 target（守恒）。
            k_act = _get_param(tgt_name, "k_act", 0.05)
            # [RC-FIX-PI3K-Activation-kDegKeyAlign] 对齐 RCA-1 键名约定：
            # specialist 提供的是 `degradation` 键（如 ppAKT degradation=0.1, 半衰期 ~7 min），
            # 旧代码仅读 `k_deg` 键导致默认 0.02（半衰期 ~34.66 min）生效 →
            # ppAKT/ppERK 单调累积至 120min 不达峰（peak_time 失效）。
            # 修复：优先读 `degradation`，回退到 `k_dephos`（与 phosphorylation 分支一致），
            # 再回退到 `k_deg`，最后回退到默认 0.02。
            # [RC-FIX-pAKT-PeakTime-r18] 根因：activation 边 AKT→pAKT 使用 k_deg=0.02
            #   而 phosphorylation 边使用 k_dephos=0.5，速率差 25 倍。
            #   pAKT 由 3 条边共同产生（1 activation + 2 phosphorylation），
            #   activation 边的慢降解使 pAKT 缓慢累积至 120min 不达峰。
            #   修复：activation 异激活分支也读取 `k_dephos` 键，与 phosphorylation 对齐。
            k_deg = _get_param(tgt_name, "degradation",
                               _get_param(tgt_name, "k_dephos",
                                          _get_param(tgt_name, "k_deg", 0.02)))
            _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 3.0
            _rate = k_act * src * max(0.0, 1.0 - tgt / _max_pool)
            _unphospho_name = tgt_name[1:] if (tgt_name.startswith("p") and len(tgt_name) > 1) else ""
            if _unphospho_name and _unphospho_name in SP_IDX:
                _unphos_idx = SP_IDX[_unphospho_name]
                dy[_unphos_idx] -= _rate            # [CAL-06] 消耗未磷酸化前体（守恒）
                dy[t_idx] += _rate                  # [Gap-EGFR-Pool] 仅在有前体时生产（守恒）
                dy[t_idx] -= k_deg * tgt
                dy[_unphos_idx] += k_deg * tgt      # [CAL-06] 回流到未磷酸化形式
            else:
                # [BENCHMARK CLOSURE / Gap-MAPK-RasGTP-Peak] 修复：
                # feedback_propagation 仅出现在反馈环中（specialist_hook 生成）。
                # 当 target 是非磷酸化形式（如 SOS）时，src 对 tgt 的作用是
                # 反馈驱动的灭活/降解（如 pERK 磷酸化 SOS → SOS 失去 GEF 活性）。
                # 旧代码 else pass 导致 SOS 持续=1.0 无衰减，gtp_gdp_exchange 分支
                # 酶浓度恒定，RasGTP 单调上升不达峰（peak_time=t_end）。
                # 修复：dy[t_idx] -= _rate 表示 src 介导的 target 灭活，
                # 使 SOS 随 pERK 激活而衰减，进而降低 RasGTP 产生率，
                # 配合 RasGTP 水解（k_hydrolysis）形成 RasGTP 瞬态峰。
                dy[t_idx] -= _rate

        elif mechanism == "activation":
            # 激活（hybrid）+ 基础降解 + logistic 饱和
            # [RC19b] 修复：原 RC16 仅有 k_deg 降解，但 k_act*src >> k_deg*tgt
            #   导致 tgt 单调递增至 60min（drift=3828%）。新增 logistic 饱和：
            #   _rate = k_act * src * (1 - tgt / max_pool)
            #   使 tgt 趋于有限稳态，配合 DUSP 负反馈形成瞬态响应（达峰后下降）
            # [CAL-06] 修复：完整质量守恒 — 消耗前体 + k_deg 回流（phosphorylation cycle）
            #   旧代码 dy[t_idx] += _rate - k_deg * tgt：
            #     1. 前向 _rate 从无中生有（不消耗前体）→ 质量创造
            #     2. k_deg * tgt 质量消失 → 质量泄漏
            #   修复（完整 phosphorylation cycle）：
            #     前向：消耗未磷酸化前体（如 MEK→pMEK），src 是催化剂不被消耗
            #     逆向：k_deg 回流到未磷酸化形式（pMEK→MEK）
            #   总质量守恒：MEK + pMEK = const
            #   无法推断未磷酸化形式时不消耗质量（保守策略）
            # [RC-FIX-PI3K-Activation] 修复 activation 对非 p-前缀 target 零产出 bug：
            #   旧逻辑仅通过 tgt_name[1:] 推断前体（仅适用于 pX→X 形式，如 pAKT→AKT），
            #   完全忽略 edge.substrate 字段，导致 PI3K 通路中 PIP3/RhebGTP/mTORC1 等
            #   非 p-前缀 target 进入 else 分支零产出，通路传播中断。
            #   修复：优先使用 edge.substrate 字段（specialist 已显式标注），
            #   其次才用 tgt_name[1:] 推断（适用于 LLM 生成的 pX 形式边）。
            #   参考 transcriptional_delay.j2 的 phosphorylation 修复模式。
            # [RC-FIX-PI3K-Activation-r17] 修复 activation 异激活分支动力学参数 + 守恒池：
            #   根因 r16 抽检发现 PIP3 peak_time=120min（未达峰）+ peak=0.253（远低于期望）。
            #   诊断：
            #   1. _max_pool 仅基于 target 初始浓度（Y0_PIP3=0 → max_pool=0.3），
            #      未用 substrate+target 守恒池（PIP2+PIP3=1.0），限制 PIP3 累积。
            #   2. 旧代码用 k_act 默认 0.05，但 specialist 提供的是 k_cat=2.0（键名不匹配），
            #      速率被低估 40 倍。
            #   3. logistic 形式 (1 - tgt/max_pool) 与 phosphorylation 分支 MM 动力学不一致。
            #   修复：异激活子分支（substrate 存在且 != target）对齐 phosphorylation 分支：
            #     - _pool_init = Y0[substrate] + Y0[target]（守恒池）
            #     - _max_pool = _pool_init * 5.0（级联放大乘数）
            #     - _rate = k_cat * src * sub_conc / (Km + sub_conc)（Michaelis-Menten）
            #     - 使用 k_cat / Km 键（与 specialist 参数对齐）
            #   来源：oscillatory_feedback.j2 第 213-256 行 phosphorylation 分支（RC29 + C6-AMP 修复）
            # [RCA-38 P1 修复] k_cat 改为通路特异性（_pk("act_k_cat")）
            k_cat = _get_param(tgt_name, "k_cat", _get_param(tgt_name, "k_act", _pk("act_k_cat")))
            Km = _get_param(tgt_name, "Km", 0.1)
            # [RC-FIX-PI3K-Activation-kDegKeyAlign] 对齐 RCA-1 键名约定：
            # specialist 提供的是 `degradation` 键（如 ppAKT degradation=0.1, 半衰期 ~7 min），
            # 旧代码仅读 `k_deg` 键导致默认 0.02（半衰期 ~34.66 min）生效 →
            # ppAKT/ppERK 单调累积至 120min 不达峰（peak_time 失效）。
            # 修复：优先读 `degradation`，回退到 `k_dephos`（与 phosphorylation 分支一致），
            # 再回退到 `k_deg`，最后回退到默认 0.02。
            # [RC-FIX-pAKT-PeakTime-r18] 根因：activation 边 AKT→pAKT 使用 k_deg=0.02
            #   而 phosphorylation 边使用 k_dephos=0.5，速率差 25 倍。
            #   pAKT 由 3 条边共同产生（1 activation + 2 phosphorylation），
            #   activation 边的慢降解使 pAKT 缓慢累积至 120min 不达峰。
            #   修复：activation 异激活分支也读取 `k_dephos` 键，与 phosphorylation 对齐。
            k_deg = _get_param(tgt_name, "degradation",
                               _get_param(tgt_name, "k_dephos",
                                          _get_param(tgt_name, "k_deg", 0.02)))
            # [RC-FIX-PI3K-Activation] 优先使用 edge.substrate 字段，否则降级到 p-前缀推断
            _substrate_name = edge.get("substrate", "")
            _unphospho_name = _substrate_name if _substrate_name else (
                tgt_name[1:] if (tgt_name.startswith("p") and len(tgt_name) > 1) else ""
            )
            if _unphospho_name and _unphospho_name in SP_IDX and _unphospho_name != tgt_name:
                # 异激活/异磷酸化分支：底物 != target，消耗底物 + 回流（质量守恒）
                _unphos_idx = SP_IDX[_unphospho_name]
                _sub_conc = y[_unphos_idx]
                # [RC-FIX-PI3K-Activation-r17] 守恒池 = 初始底物 + 初始产物（与 phosphorylation 对齐）
                _pool_init = (Y0[_unphos_idx] if _unphos_idx < len(Y0) else 0.0) + (Y0[t_idx] if t_idx < len(Y0) else 0.0)
                _max_pool = max(_pool_init, 0.1)  # 严格守恒（回退 S2.1，原 *5.0）
                # [RC-FIX-PI3K-Activation-r17] Michaelis-Menten 动力学（与 phosphorylation 对齐）
                _rate = k_cat * src * _sub_conc / (Km + _sub_conc) if (Km + _sub_conc) > 0 else 0.0
                _avail = max(0.0, _max_pool - tgt)
                _rate = min(_rate, _avail)
                # 底物下限保护：_rate 不能超过当前底物浓度
                _rate = min(_rate, max(0.0, _sub_conc))
                dy[_unphos_idx] -= _rate            # [CAL-06] 消耗未磷酸化前体（守恒）
                dy[t_idx] += _rate                  # [Gap-EGFR-Pool] 仅在有前体时生产（守恒）
                dy[t_idx] -= k_deg * tgt
                dy[_unphos_idx] += k_deg * tgt      # [CAL-06] 回流到未磷酸化形式
            elif t_idx >= 0 and (Y0[t_idx] if t_idx < len(Y0) else 0.0) > 0.0:
                # [RC-FIX-PI3K-Activation-NoSubstrate] 无 substrate 但 target 是预存物种（Y0>0）：
                #   激酶变构激活预存物种，target 活性增加，src 不被消耗。
                _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 3.0
                _rate = k_cat * src * max(0.0, 1.0 - tgt / _max_pool)
                dy[t_idx] += _rate                  # target 活性增加
                dy[t_idx] -= k_deg * tgt             # 降解回到基础水平
            elif t_idx >= 0:
                # [RC-FIX-PI3K-Activation-NewSpecies] 无 substrate 且 target 初始浓度=0（新物种）：
                #   消耗 source 产生 target（信号传递需质量转移），避免质量凭空创造。
                _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 3.0
                _rate = k_cat * src * max(0.0, 1.0 - tgt / _max_pool)
                dy[s_idx] -= _rate
                dy[t_idx] += _rate
                dy[t_idx] -= k_deg * tgt
            # else: target 不在 SP_IDX，不生产质量（保守策略）

        else:
            # 默认：mass-action + 基础降解 + logistic 饱和
            # [RC19b] 同 activation，添加 logistic 饱和防止单调递增
            # [CAL-06] 修复：k_deg 降解应回流到 src（守恒闭合环）
            #   旧代码 dy[t_idx] += _rate - k_deg * tgt 中 k_deg * tgt 质量消失
            #   修复：k_deg * tgt 回流到 src（如 dephosphorylation 语义）
            k_default = _get_param(tgt_name, "k", 0.01)
            k_deg = _get_param(tgt_name, "k_deg", 0.005)
            _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 3.0
            _rate = k_default * src * max(0.0, 1.0 - tgt / _max_pool)
            dy[s_idx] -= _rate
            dy[t_idx] += _rate
            dy[t_idx] -= k_deg * tgt
            dy[s_idx] += k_deg * tgt  # [CAL-06] 回流到 src（守恒闭合环）

    return dy


# [v5 Recovery Sprint 1 / RC1] _dde_rhs 已移除：_ode_rhs 现直接支持 y_delayed 参数
# 旧 _dde_rhs 的 IB-030 双重计数修复逻辑已合并到 _ode_rhs 的 transcription 边中


# =============================================================================
# 求解器选择（TD-009 模式：三分支 DDE 求解）
# =============================================================================
def solve_oscillatory():
    """求解振荡反馈通路。

    [v5 Recovery Sprint 1 / RC1] DDE 接线，参照 TD-009 模式。
    三分支：
      1. DDE_DELAY > 0 且 DDE 可用 → 调用 solve_dde 真实 DDE 求解
      2. DDE_DELAY > 0 但 DDE 不可用 → 降级为 ODE + 打印警告
      3. 无延迟 → 正常 ODE 求解

    Returns:
        (t_arr, y_arr, dde_used): 时间序列、状态序列、是否使用了 DDE
    """
    t_eval = np.linspace(0, T_END, N_EVAL)

    # [RCA-37 修复 C3] 根据 PATHWAY_CLASS 动态选择 max_step
    # 根因：旧逻辑固定 max_step=MAX_STEP_MEDIUM=0.5min，对所有通路一视同仁，
    #   导致 EGFR_RTK (1-5min 达峰) 求解步长过大错过峰值细节，
    #   CELL_CYCLE (1-24h) 步长过小浪费计算资源。
    # 修复：按通路生物学时间尺度选择 max_step
    _PATHWAY_MAX_STEP = {
        "EGFR_RTK": MAX_STEP_FAST,       # 0.1min：受体信号快速
        "MAPK_ERK": MAX_STEP_FAST,       # 0.1min：级联传播
        "PI3K_AKT_mTOR": MAX_STEP_MEDIUM, # 0.5min：代谢通路
        "p53": MAX_STEP_MEDIUM,          # 0.5min：转录延迟
        "APOPTOSIS": MAX_STEP_MEDIUM,    # 0.5min：凋亡级联
        "CELL_CYCLE": MAX_STEP_SLOW,     # 1.0min：细胞周期
        "JAK_STAT": MAX_STEP_MEDIUM,     # 0.5min：细胞因子
        "NF_KB": MAX_STEP_MEDIUM,        # 0.5min：炎症信号
        "WNT": MAX_STEP_SLOW,           # 1.0min：发育信号
        "TGF_BETA": MAX_STEP_SLOW,       # 1.0min：生长因子
        "CROSS_PATHWAY": MAX_STEP_MEDIUM, # 0.5min：跨通路默认
    }
    _pc_upper = (PATHWAY_CLASS or "").strip().upper()
    _SELECTED_MAX_STEP = _PATHWAY_MAX_STEP.get(_pc_upper, MAX_STEP_MEDIUM)
    print(f"[RCA-37] pathway={PATHWAY_CLASS} → max_step={_SELECTED_MAX_STEP}")

    if DDE_DELAY > 0 and is_dde_available():
        # 分支1：延迟 > 0 且 DDE 可用 → 调用 solve_dde 真实 DDE 求解
        print(f"[v5] RC1: 调用 solve_dde 真实 DDE 求解（τ={DDE_DELAY} min）")
        dde_result = solve_dde(
            rhs=_ode_rhs,
            t_span=(0, T_END),
            y0=Y0,
            delay=DDE_DELAY,
            t_eval=t_eval,
            max_step=_SELECTED_MAX_STEP,
        )
        t_arr = np.asarray(dde_result["t"])
        y_arr = np.asarray(dde_result["y"])
        _dde_used = dde_result.get("dde_used", True)
    elif DDE_DELAY > 0 and not is_dde_available():
        # 分支2：延迟 > 0 但 DDE 不可用 → 降级为 ODE + 打印警告
        print(f"[v5] RC1 DOWNGRADE WARNING: jitcdde 不可用，"
              f"DDE 延迟 τ={DDE_DELAY} min 失效（y(t-τ)≈y(t)），降级为 ODE 求解")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=_SELECTED_MAX_STEP, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False
    else:
        # 分支3：无延迟 → 正常 ODE 求解
        print(f"[v5] RC1: 无延迟（DDE_DELAY=0），使用 ODE 求解")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=_SELECTED_MAX_STEP, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False

    return t_arr, y_arr, _dde_used


# =============================================================================
# 主程序
# =============================================================================
if __name__ == "__main__":
    # [BM 修复] Y0 全零保护：若无初始扰动则注入默认值，避免仿真输出全零
    _y0_arr = np.asarray(Y0, dtype=float)
    if np.all(_y0_arr == 0.0) and N_SP > 0:
        print("[v4] WARNING: Y0 全零，注入默认扰动（Y0[0]=1.0）以驱动仿真")
        Y0 = list(_y0_arr)
        Y0[0] = 1.0

    # [v5 Recovery Sprint 1 / RC1] 主程序使用 3 值返回签名 (t, y, dde_used)
    t_arr, y_arr, _dde_used = solve_oscillatory()

    # [RCA-38 P0 修复 RC-2] C3 非负性修复：clamp 负浓度（生物学无意义）
    y_arr = np.maximum(y_arr, 0.0)

    # BIO_CHECK: simulation_complete, n_species=N_SP, n_steps=len(t_arr)
    # BIO_CHECK: max_conc={max(y_arr[:,i]) for i in range(N_SP)}
    # BIO_CHECK: min_conc={min(y_arr[:,i]) for i in range(N_SP)}
    print(f"# BIO_CHECK: simulation_complete, n_species={N_SP}, n_steps={len(t_arr)}")
    print(f"# BIO_CHECK: max_conc={[float(np.max(y_arr[:, i])) for i in range(N_SP)]}")
    print(f"# BIO_CHECK: min_conc={[float(np.min(y_arr[:, i])) for i in range(N_SP)]}")

    # [BM 修复] 生成 simulation.csv + simulation.png（sandbox.py 要求）
    # sandbox.py 通过检查 simulation.png 是否存在判定 status=success，
    # 通过 simulation.csv 读取仿真数据供报告生成。
    try:
        header = "t," + ",".join(SPECIES_NAMES)
        data = np.column_stack([t_arr, y_arr])
        np.savetxt("simulation.csv", data, delimiter=",", header=header, comments="")

        fig, ax = plt.subplots(figsize=(10, 6))
        for i, sp in enumerate(SPECIES_NAMES):
            if i < y_arr.shape[1]:
                ax.plot(t_arr, y_arr[:, i], label=sp, linewidth=1.5)
        ax.set_xlabel("Time")
        ax.set_ylabel("Concentration")
        ax.set_title("Simulation: Oscillatory Feedback")
        ax.legend(loc="upper right", fontsize=8)
        ax.grid(alpha=0.3)
        fig.tight_layout()
        fig.savefig("simulation.png", dpi=120)
        plt.close(fig)
    except Exception as _e:
        print(f"[v4] CSV/PNG 生成失败: {_e}")

    # BIO_CHECK 终态输出（sandbox 生物学检查）
    for i, sp in enumerate(SPECIES_NAMES):
        if i < y_arr.shape[1]:
            val = float(y_arr[-1, i])
            safe_val = max(val, 0.0) if np.isfinite(val) else 0.0
            print(f"BIO_CHECK: {sp} = {safe_val:.4f}")

    # 仿真结果保存
    import json
    result = {
        "species_names": SPECIES_NAMES,
        "time_points": t_arr.tolist(),
        "concentrations": y_arr.tolist(),
        "dde_delay_minutes": DDE_DELAY,
        "dde_available": _JITCDDE_AVAILABLE,
        "dde_used": _dde_used,
        "requires_dde": REQUIRES_DDE,
    }
    print(json.dumps(result, default=str))
