{# v4 ODE Template: Cyclin-CDK Toggle 模板（Cyclin-CDK Toggle Template）
   对应 PART C5 + 审计 §3.2 无 bistable + §3.2 无 oscillatory。

   适用通路：
     - Cell_Cycle (Cyclin B-APC/C 延迟负反馈振子 + Rb-E2F G1/S toggle)

   关键特性：
     1. 双稳态 toggle（Rb-E2F G1/S switch）
     2. 延迟负反馈振子（Cyclin B-APC/C）
     3. CDK 抑制（p21/p27）
     4. 多时间尺度：MEDIUM (Cyclin) + SLOW (APC/C)

   参数：
     - SPECIES_NAMES: 物种列表
     - EDGES: 反应边列表
     - PARAMS: 每个物种的动力学参数
     - T_END: 仿真总时长（分钟）
     - DDE_DELAY: APC/C 延迟（分钟，默认 30）
#}
"""
ODE 仿真（v4 Cyclin-CDK Toggle 模板）— Cyclin-CDK Toggle Template
- 适用：Cell Cycle（Cyclin-CDK toggle + APC/C 振子）
- 双稳态 toggle（Rb-E2F）+ 延迟负反馈振子（Cyclin B-APC/C）
- 多时间尺度：MEDIUM + SLOW

对应审计修复：
  §3.2 无 bistable → 新增 Rb-E2F toggle
  §3.2 无 oscillatory → 新增 Cyclin B-APC/C 振子
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
EDGES = {{ edges_json }}
PARAMS = {{ params_json }}
DDE_DELAY = {{ dde_delay_minutes }}
REQUIRES_DDE = {{ requires_dde | default(false) }}
PATHWAY_CLASS = "{{ pathway_class | default('') }}"

N_SP = len(SPECIES_NAMES)
SP_IDX = {name: i for i, name in enumerate(SPECIES_NAMES)}

MAX_STEP_MEDIUM = 0.5
MAX_STEP_SLOW = 1.0

# =============================================================================
# DDE 求解器（TD-009 模式：从 app.solvers.dde_solver 导入）
# [v5 Recovery Sprint 1 / RC1] DDE 接线，参照 transcriptional_delay.j2 TD-009
# 旧实现: jitcdde try-import 但主程序直接走 solve_ivp（死代码，延迟失效）
# 修复: 使用 app.solvers.dde_solver.solve_dde 真实调用 DDE 求解器
# =============================================================================
from app.solvers.dde_solver import solve_dde, is_dde_available
_JITCDDE_AVAILABLE = is_dde_available()


# [RCA-20 修复 B] _get_param clamp 机制
# 根因：_get_param 无 clamp/clip，SBML 原生参数（如 633,250）原样返回导致数值爆炸
# 修复：按 param_key 类型设置上限，超界值截断到上限
# Feature Flag: V4_GET_PARAM_CLAMP_ENABLED（默认 OFF，回退安全）
_V4_GET_PARAM_CLAMP_ENABLED = {{ v4_get_param_clamp_enabled }}
_PARAM_CLAMP_MAX = {
    "k_cat": 10.0, "kcat": 10.0, "k_act": 10.0, "kact": 10.0,
    "k_phos": 10.0, "kphos": 10.0, "k1": 10.0, "k1f": 10.0, "kf": 10.0, "k": 10.0,
    "k_inhibit": 10.0, "ki": 10.0, "koff": 10.0, "k1b": 10.0, "kb": 10.0,
    "k_deg": 1.0, "kdeg": 1.0, "k_dephos": 1.0, "kdephos": 1.0, "k2": 1.0,
    "vmax": 100.0, "Vmax": 100.0, "km": 100.0, "Km": 100.0,
    "kon": 100.0, "kd": 100.0, "ic50": 100.0,
}


def _get_param(target_name, param_key, default):
    """从 PARAMS 中获取指定 target 的参数值。

    [RCA-20 修复 B] 当 V4_GET_PARAM_CLAMP_ENABLED=true 时，
    对超界参数值做 clamp（截断到生物学合理上限）。
    """
    eparams = PARAMS.get(target_name, {})
    value = eparams.get(param_key, default)
    if _V4_GET_PARAM_CLAMP_ENABLED and isinstance(value, (int, float)):
        max_val = _PARAM_CLAMP_MAX.get(param_key)
        if max_val is not None and value > max_val:
            return float(max_val)
    return value


# [RCA-38 P1 修复 RC-1g] CellCycle 通路特异性动力学参数表
# 根因：cyclin_cdk_toggle.j2 所有动力学参数（k_trans=0.1, k_transl=0.05, k_ubi=0.1,
#   k_act=0.05）均为分钟级，导致振荡周期 ~280min（约 4.7h），
#   而 CellCycle 期望振荡周期 16-24h（首峰 [600,960]min）。
#   实际周期比期望快 3-5 倍。
# 修复：当 PATHWAY_CLASS="CELL_CYCLE" 时，使用小时级参数（k_trans=0.005 等），
#   使振荡周期达到 960-1440min。
_PATHWAY_KINETICS = {
    # CellCycle 小时级参数：振荡周期 16-24h
    "CELL_CYCLE":     {"phos_k_cat": 0.05, "act_k_cat": 0.02, "trans_k": 0.005,
                       "transl_k": 0.002, "ubi_k": 0.005, "deg_k": 0.002,
                       "bind_k": 0.01, "inhib_k": 0.005, "dephos_k": 0.002},
    # 默认（非 CellCycle 通路，如交叉通路）：分钟级参数
    "DEFAULT":        {"phos_k_cat": 0.1, "act_k_cat": 0.05, "trans_k": 0.1,
                       "transl_k": 0.05, "ubi_k": 0.1, "deg_k": 0.05,
                       "bind_k": 0.1, "inhib_k": 0.05, "dephos_k": 0.05},
}
_pathway_kin = _PATHWAY_KINETICS.get(
    (PATHWAY_CLASS or "").strip().upper(),
    _PATHWAY_KINETICS["DEFAULT"],
)


def _pk(param_type):
    """返回通路特异性的动力学参数默认值。

    [RCA-38 P1 修复 RC-1g] 替代硬编码的 _get_param default 值，
    按 PATHWAY_CLASS 选择生物学合理的时间尺度参数。
    CellCycle 通路使用小时级参数（k_trans=0.005 等）。
    """
    return _pathway_kin.get(param_type, 0.05)


# [RC25g] 去重预计算：对同一 (source, target) 对，若已有非 activation 机制，
# 则跳过 activation 边，防止 LLM activation 边与 specialist phosphorylation 边重复创建产物
_skip_edge_indices: set[int] = set()
_pair_best_mech: dict[tuple[str, str], str] = {}
_pair_best_idx: dict[tuple[str, str], int] = {}
for _i, _e in enumerate(EDGES):
    _pair = (_e.get("source", ""), _e.get("target", ""))
    _mech = (_e.get("mechanism") or "activation").lower()
    if _pair in _pair_best_mech:
        _prev_mech = _pair_best_mech[_pair]
        if _prev_mech != "activation" and _mech == "activation":
            _skip_edge_indices.add(_i)
        elif _prev_mech == "activation" and _mech != "activation":
            _skip_edge_indices.add(_pair_best_idx[_pair])
            _pair_best_mech[_pair] = _mech
            _pair_best_idx[_pair] = _i
    else:
        _pair_best_mech[_pair] = _mech
        _pair_best_idx[_pair] = _i
if _skip_edge_indices:
    print(f"[RC25g] 跳过 {len(_skip_edge_indices)} 条重复 activation 边")


def _ode_rhs(t, y, y_delayed=None):
    """ODE 右端函数（Cyclin-CDK Toggle 模板，支持 DDE 延迟状态）。

    [v5 Recovery Sprint 1 / RC1] 参照 TD-009 模式，新增 y_delayed 参数。
    - ODE 模式（y_delayed=None）：y(t-τ) ≈ y(t)，转录用当前 TF 浓度
    - DDE 模式（y_delayed 提供值）：转录使用 y_delayed（即 y(t-τ)）作为 TF 浓度
    """
    dy = np.zeros(N_SP)
    y = np.maximum(y, 0.0)  # TD-001 修复：负浓度保护（防 Hill src**n 对负底数产生 NaN）
    # [v5 RC1] DDE 模式下使用延迟状态；ODE 模式下 y_delayed = y
    if y_delayed is None:
        y_delayed = y
    else:
        y_delayed = np.maximum(y_delayed, 0.0)
    for _edge_idx, edge in enumerate(EDGES):
        if _edge_idx in _skip_edge_indices:  # [RC25g] 跳过重复 activation 边
            continue
        src_name = edge.get("source", "")
        tgt_name = edge.get("target", "")
        mechanism = edge.get("mechanism", "activation")
        # [BENCHMARK CLOSURE / Gap 1] 修复：degradation 类机制（degradation /
        # proteasomal_degradation）的 target 是 sink（∅ 或未注册的降解产物池）。
        # 仅要求 source 在 SP_IDX；target 缺失时，不写入 dy[t_idx]，仅消耗 source。
        # 旧逻辑：`if src_name not in SP_IDX or tgt_name not in SP_IDX: continue`
        # 静默丢弃所有 target 未注册的 degradation 边 → 物种永不衰减 → 数值爆炸。
        _mech_lower = (mechanism or "activation").lower()
        _is_sink_mechanism = _mech_lower in ("degradation", "proteasomal_degradation")
        if src_name not in SP_IDX:
            continue
        if not _is_sink_mechanism and tgt_name not in SP_IDX:
            continue
        s_idx = SP_IDX[src_name]
        t_idx = SP_IDX.get(tgt_name, -1)
        src = y[s_idx]
        tgt = y[t_idx] if t_idx >= 0 else 0.0

        if mechanism == "phosphorylation":
            # CDK 磷酸化 Rb（Michaelis-Menten）
            # [RCA-38 P1 修复 RC-1g] k_cat/k_dephos 默认值改为通路特异性（_pk）
            k_cat = _get_param(tgt_name, "k_cat", _pk("phos_k_cat"))
            Km = _get_param(tgt_name, "Km", 0.1)
            # [RC25c] 0.001→0.05: 防止磷酸化形式质量爆炸（半衰期从 693min 降至 14min）
            k_dephos = _get_param(tgt_name, "k_dephos", _pk("dephos_k"))
            modifiers = edge.get("modifiers", [])
            _enzyme_idx = SP_IDX.get(modifiers[0]) if modifiers else None
            _enzyme_conc = max(float(y[_enzyme_idx]), 0.0) if _enzyme_idx is not None else 0.1
            _Vmax = k_cat * _enzyme_conc
            _rate = _Vmax * src / (Km + src) if (Km + src) > 0 else 0.0
            sub_idx = s_idx  # [RC25e] 记录底物索引用于去磷酸化回流
            dy[s_idx] -= _rate
            dy[t_idx] += _rate
            # [RC25e] 修复质量泄漏：去磷酸化产物必须返回底物池
            _dephos_rate = k_dephos * tgt
            dy[t_idx] -= _dephos_rate
            dy[sub_idx] += _dephos_rate  # 去磷酸化产物返回底物池

        elif mechanism == "binding":
            # Cyclin-CDK 结合（mass-action）
            # [RCA-38 P1 修复 RC-1g] k_bind 改为通路特异性（_pk）
            k_bind = _get_param(tgt_name, "k_bind", _pk("bind_k"))
            _rate = k_bind * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "dissociation":
            # CDK 抑制剂解离（p21/p27）
            k_diss = _get_param(tgt_name, "k_diss", 0.01)
            _rate = k_diss * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "ubiquitination":
            # APC/C 泛素化 Cyclin B
            # [RCA-38 P1 修复 RC-1g] k_ubi 改为通路特异性（_pk）
            k_ubi = _get_param(tgt_name, "k_ubi", _pk("ubi_k"))
            Km_ubi = _get_param(tgt_name, "Km_ubi", 0.5)
            _rate = k_ubi * src * tgt / (Km_ubi + tgt) if (Km_ubi + tgt) > 0 else 0.0
            dy[t_idx] -= _rate

        elif mechanism == "degradation":
            # [BENCHMARK CLOSURE / Gap 1] 新增 degradation 分支
            # 生物语义：source → ∅（一级 mass-action 衰减）。
            # target 是 sink（∅ 或未注册的降解产物池），不写入 dy[t_idx]。
            # [RCA-38 P1 修复 RC-1g] k_deg fallback 改为通路特异性（_pk）
            k_deg = _get_param(tgt_name, "k_deg", None)
            if k_deg is None:
                k_deg = _get_param(src_name, "k_deg", _pk("deg_k"))
            _rate = k_deg * src
            dy[s_idx] -= _rate
            if t_idx >= 0:
                dy[t_idx] += _rate

        elif mechanism == "proteasomal_degradation":
            # Cyclin 降解
            # [RCA-38 P1 修复 RC-1g] k_deg 改为通路特异性（_pk）
            k_deg = _get_param(tgt_name, "k_deg", _pk("deg_k"))
            _rate = k_deg * src
            dy[s_idx] -= _rate

        elif mechanism == "transcription":
            # E2F → Cyclin E/D1 转录（Hill，含延迟）
            # [v5 RC1] DDE: 使用 y_delayed[s_idx] 作为 TF 浓度（τ 分钟前的 E2F 驱动当前转录）
            # [RCA-38 P1 修复 RC-1g] k_trans 改为通路特异性（_pk）
            k_trans = _get_param(tgt_name, "k_trans", _pk("trans_k"))
            n_hill = _get_param(tgt_name, "n_hill", 2.0)
            K_d = _get_param(tgt_name, "K_d", 0.5)
            k_mRNA_deg = _get_param(tgt_name, "k_mRNA_deg", 0.01)
            # Hill 函数：v = k_trans * [TF(t-τ)]^n / (K_d^n + [TF(t-τ)]^n)
            src_eff = y_delayed[s_idx]  # DDE: TF 用延迟状态
            _hill = (src_eff ** n_hill) / (K_d ** n_hill + src_eff ** n_hill) if (K_d ** n_hill + src_eff ** n_hill) > 0 else 0.0
            # [RC25f] logistic 饱和：防止 mRNA 无限累积
            _max_mRNA = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_trans * _hill * max(0.0, 1.0 - tgt / _max_mRNA)
            dy[t_idx] += _rate
            dy[t_idx] -= k_mRNA_deg * tgt

        elif mechanism == "translation":
            # [RCA-38 P1 修复 RC-1g] k_transl 改为通路特异性（_pk）
            k_transl = _get_param(tgt_name, "k_transl", _pk("transl_k"))
            k_prot_deg = _get_param(tgt_name, "k_prot_deg", 0.005)
            # [RC25f] logistic 饱和：防止蛋白无限累积
            _max_prot = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_transl * src * max(0.0, 1.0 - tgt / _max_prot)
            dy[t_idx] += _rate
            dy[t_idx] -= k_prot_deg * tgt

        elif mechanism == "inhibition":
            # p21/p27 抑制 Cyclin-CDK
            # [RCA-38 P1 修复 RC-1g] k_inhib 改为通路特异性（_pk）
            k_inhib = _get_param(tgt_name, "k_inhib", _pk("inhib_k"))
            _rate = k_inhib * src * tgt
            dy[t_idx] -= _rate

        elif mechanism == "activation":
            # APC/C 激活（Cdc20）
            # [BENCHMARK CLOSURE / Gap-NumericalExplosion] 修复：旧代码 dy[t_idx] += k_act * src
            #   无饱和、无守恒、无降解，导致 CELL_CYCLE 16M× 数值爆炸。
            #   修复（与 oscillatory_feedback.j2 对齐）：
            #     1. logistic 饱和防止单调递增
            #     2. 消耗未激活前体（如 APC_C → APC_C_active）实现质量守恒
            #     3. k_deg 降解回流到未激活形式
            # [RCA-38 P1 修复 RC-1g] k_act 改为通路特异性（_pk）
            k_act = _get_param(tgt_name, "k_act", _pk("act_k_cat"))
            k_deg = _get_param(tgt_name, "k_deg", _pk("deg_k"))
            _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 3.0
            _rate = k_act * src * max(0.0, 1.0 - tgt / _max_pool)
            _unphospho_name = tgt_name[1:] if (tgt_name.startswith("p") and len(tgt_name) > 1) else ""
            if _unphospho_name and _unphospho_name in SP_IDX:
                _unphos_idx = SP_IDX[_unphospho_name]
                dy[_unphos_idx] -= _rate
                dy[t_idx] += _rate
                dy[t_idx] -= k_deg * tgt
                dy[_unphos_idx] += k_deg * tgt
            else:
                # 无明确前体：仅 logistic 饱和生产（防止无界增长）
                dy[t_idx] += _rate
                dy[t_idx] -= k_deg * tgt

        else:
            k_default = _get_param(tgt_name, "k", 0.01)
            _rate = k_default * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

    return dy


def detect_toggle_and_oscillation(t_arr, y_arr, threshold_ratio=0.5):
    """检测 Rb-E2F toggle 与 Cyclin B-APC/C 振荡。

    判定规则：
      - 找到 E2F 物种（toggle 标志）
      - 找到 Cyclin B 物种（振荡标志）
      - E2F 最终状态判定 ON/OFF（toggle）
      - Cyclin B 检测振荡（峰值数 ≥ 2）
    """
    e2f_idx = -1
    cyclinb_idx = -1
    for i, name in enumerate(SPECIES_NAMES):
        lower = name.lower()
        if "e2f" in lower:
            e2f_idx = i
        if "cyclinb" in lower or "cyclin_b" in lower:
            cyclinb_idx = i

    result = {
        "toggle_detected": e2f_idx >= 0,
        "oscillation_detected": False,
    }

    if e2f_idx >= 0:
        e2f_series = y_arr[:, e2f_idx]
        e2f_max = float(np.max(e2f_series))
        e2f_final = float(e2f_series[-1])
        threshold = e2f_max * threshold_ratio
        if e2f_final >= threshold and e2f_max > 0:
            result["e2f_state"] = "ON"
        elif e2f_final < threshold * 0.1:
            result["e2f_state"] = "OFF"
        else:
            result["e2f_state"] = "TRANSIENT"
        result["e2f_max"] = e2f_max
        result["e2f_final"] = e2f_final

    if cyclinb_idx >= 0:
        cyclinb_series = y_arr[:, cyclinb_idx]
        # 简单振荡检测：找峰值数
        from scipy.signal import find_peaks
        try:
            peaks, _ = find_peaks(cyclinb_series, height=float(np.max(cyclinb_series)) * 0.3)
            n_peaks = len(peaks)
            result["oscillation_detected"] = n_peaks >= 2
            result["cyclinb_peak_count"] = n_peaks
            if n_peaks >= 2:
                # 估算周期
                peak_times = [float(t_arr[p]) for p in peaks]
                periods = [peak_times[i+1] - peak_times[i] for i in range(len(peak_times)-1)]
                result["oscillation_period_minutes"] = float(np.mean(periods))
        except Exception:
            result["oscillation_detected"] = False

    return result


# =============================================================================
# 求解器选择（TD-009 模式：三分支 DDE 求解）
# =============================================================================
def solve_toggle():
    """求解 Cyclin-CDK Toggle 通路。

    [v5 Recovery Sprint 1 / RC1] DDE 接线，参照 TD-009 模式。
    三分支：
      1. DDE_DELAY > 0 且 DDE 可用 → 调用 solve_dde 真实 DDE 求解
      2. DDE_DELAY > 0 但 DDE 不可用 → 降级为 ODE + 打印警告
      3. 无延迟 → 正常 ODE 求解

    Returns:
        (t_arr, y_arr, dde_used): 时间序列、状态序列、是否使用了 DDE
    """
    t_eval = np.linspace(0, T_END, N_EVAL)
    _max_step = MAX_STEP_SLOW if T_END > 1000 else MAX_STEP_MEDIUM

    if DDE_DELAY > 0 and is_dde_available():
        # 分支1：延迟 > 0 且 DDE 可用 → 调用 solve_dde 真实 DDE 求解
        print(f"[v5] RC1: 调用 solve_dde 真实 DDE 求解（τ={DDE_DELAY} min）")
        dde_result = solve_dde(
            rhs=_ode_rhs,
            t_span=(0, T_END),
            y0=Y0,
            delay=DDE_DELAY,
            t_eval=t_eval,
            max_step=_max_step,
        )
        t_arr = np.asarray(dde_result["t"])
        y_arr = np.asarray(dde_result["y"])
        _dde_used = dde_result.get("dde_used", True)
    elif DDE_DELAY > 0 and not is_dde_available():
        # 分支2：延迟 > 0 但 DDE 不可用 → 降级为 ODE + 打印警告
        print(f"[v5] RC1 DOWNGRADE WARNING: jitcdde 不可用，"
              f"DDE 延迟 τ={DDE_DELAY} min 失效（y(t-τ)≈y(t)），降级为 ODE 求解")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=_max_step, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False
    else:
        # 分支3：无延迟 → 正常 ODE 求解
        print(f"[v5] RC1: 无延迟（DDE_DELAY=0），使用 ODE 求解")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=_max_step, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False

    return t_arr, y_arr, _dde_used


