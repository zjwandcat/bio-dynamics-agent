{# v4 ODE Template: 破坏复合体模板（Destruction Complex Template）
   对应 PART C5 + 审计 §4.3 无法表达 destruction complex。

   适用通路：
     - Wnt (Axin-APC-GSK3β-CK1 destruction complex)

   关键特性：
     1. 五步耦合 CompositeReaction：binding→binding→phosphorylation→ubiquitination→proteasomal_degradation
     2. 复合体组装（multi-component mass-action）
     3. β-catenin 稳态水平检测（<10 nM 无 Wnt）

   参数：
     - SPECIES_NAMES: 物种列表
     - EDGES: 反应边列表
     - PARAMS: 每个物种的动力学参数
     - T_END: 仿真总时长（分钟）
#}
"""
ODE 仿真（v4 破坏复合体模板）— Destruction Complex Template
- 适用：Wnt β-catenin 通路
- 五步耦合 CompositeReaction
- β-catenin 稳态水平检测

对应审计修复：
  §4.3 无法表达 destruction complex → 新增五步耦合
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp
from app.solvers.dde_solver import solve_dde, is_dde_available

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
EDGES = {{ edges_json }}
PARAMS = {{ params_json }}
DDE_DELAY = {{ dde_delay_minutes }}
REQUIRES_DDE = {{ requires_dde | default(false) }}
PATHWAY_CLASS = "{{ pathway_class | default('') }}"

N_SP = len(SPECIES_NAMES)
SP_IDX = {name: i for i, name in enumerate(SPECIES_NAMES)}

MAX_STEP_FAST = 0.1
MAX_STEP_MEDIUM = 0.5


# [RCA-20 修复 B] _get_param clamp 机制
# 根因：_get_param 无 clamp/clip，SBML 原生参数（如 633,250）原样返回导致数值爆炸
# 修复：按 param_key 类型设置上限，超界值截断到上限
# Feature Flag: V4_GET_PARAM_CLAMP_ENABLED（默认 OFF，回退安全）
_V4_GET_PARAM_CLAMP_ENABLED = {{ v4_get_param_clamp_enabled }}
_PARAM_CLAMP_MAX = {
    "k_cat": 10.0, "kcat": 10.0, "k_act": 10.0, "kact": 10.0,
    "k_phos": 10.0, "kphos": 10.0, "k1": 10.0, "k1f": 10.0, "kf": 10.0, "k": 10.0,
    "k_inhibit": 10.0, "ki": 10.0, "koff": 10.0, "k1b": 10.0, "kb": 10.0,
    "k_deg": 1.0, "kdeg": 1.0, "k_dephos": 1.0, "kdephos": 1.0, "k2": 1.0,
    "vmax": 100.0, "Vmax": 100.0, "km": 100.0, "Km": 100.0,
    "kon": 100.0, "kd": 100.0, "ic50": 100.0,
}


def _get_param(target_name, param_key, default):
    """从 PARAMS 中获取指定 target 的参数值。

    [RCA-20 修复 B] 当 V4_GET_PARAM_CLAMP_ENABLED=true 时，
    对超界参数值做 clamp（截断到生物学合理上限）。
    """
    eparams = PARAMS.get(target_name, {})
    value = eparams.get(param_key, default)
    if _V4_GET_PARAM_CLAMP_ENABLED and isinstance(value, (int, float)):
        max_val = _PARAM_CLAMP_MAX.get(param_key)
        if max_val is not None and value > max_val:
            return float(max_val)
    return value


# [RC25g] 去重预计算：对同一 (source, target) 对，若已有非 activation 机制，
# 则跳过 activation 边，防止 LLM activation 边与 specialist phosphorylation 边重复创建产物
_skip_edge_indices: set[int] = set()
_pair_best_mech: dict[tuple[str, str], str] = {}
_pair_best_idx: dict[tuple[str, str], int] = {}
for _i, _e in enumerate(EDGES):
    _pair = (_e.get("source", ""), _e.get("target", ""))
    _mech = (_e.get("mechanism") or "activation").lower()
    if _pair in _pair_best_mech:
        _prev_mech = _pair_best_mech[_pair]
        if _prev_mech != "activation" and _mech == "activation":
            _skip_edge_indices.add(_i)
        elif _prev_mech == "activation" and _mech != "activation":
            _skip_edge_indices.add(_pair_best_idx[_pair])
            _pair_best_mech[_pair] = _mech
            _pair_best_idx[_pair] = _i
    else:
        _pair_best_mech[_pair] = _mech
        _pair_best_idx[_pair] = _i
if _skip_edge_indices:
    print(f"[RC25g] 跳过 {len(_skip_edge_indices)} 条重复 activation 边")


def _ode_rhs(t, y, y_delayed=None):
    """Wnt RHS; delayed state drives AXIN2 transcription when DDE is active."""
    dy = np.zeros(N_SP)
    y = np.maximum(y, 0.0)  # TD-001 修复：负浓度保护（防 Hill src**n 对负底数产生 NaN）
    if y_delayed is None:
        y_delayed = y
    else:
        y_delayed = np.maximum(y_delayed, 0.0)
    for _edge_idx, edge in enumerate(EDGES):
        if _edge_idx in _skip_edge_indices:  # [RC25g] 跳过重复 activation 边
            continue
        src_name = edge.get("source", "")
        tgt_name = edge.get("target", "")
        mechanism = edge.get("mechanism", "activation")
        # [BENCHMARK CLOSURE / Gap 1] 修复：degradation 类机制（degradation /
        # proteasomal_degradation）的 target 是 sink（∅ 或未注册的降解产物池）。
        # 仅要求 source 在 SP_IDX；target 缺失时，不写入 dy[t_idx]，仅消耗 source。
        # 旧逻辑：`if src_name not in SP_IDX or tgt_name not in SP_IDX: continue`
        # 静默丢弃所有 target 未注册的 degradation 边 → 物种永不衰减 → 数值爆炸。
        _mech_lower = (mechanism or "activation").lower()
        _is_sink_mechanism = _mech_lower in ("degradation", "proteasomal_degradation")
        if src_name not in SP_IDX:
            continue
        if not _is_sink_mechanism and tgt_name not in SP_IDX:
            continue
        s_idx = SP_IDX[src_name]
        t_idx = SP_IDX.get(tgt_name, -1)
        src = y[s_idx]
        tgt = y[t_idx] if t_idx >= 0 else 0.0

        if mechanism == "complex_formation":
            # 复合体组装（multi-component mass-action，简化为一级）
            # [P0-FIX Wnt C3 回归] 添加 logistic 饱和限制：
            #   根因：Axin_APC_GSK3b_bcat fold=64.86 > C3 阈值 50，
            #   因旧实现无饱和上限，复合物持续累积。修复：限制 max_pool = Y0*5.0。
            k_form = _get_param(tgt_name, "k_form", 0.1)
            _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_form * src * max(0.0, 1.0 - tgt / _max_pool)
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "binding":
            # 结合（mass-action）
            # [P0-FIX Wnt C3 回归] 同步添加 logistic 饱和限制
            k_bind = _get_param(tgt_name, "k_bind", 0.1)
            _max_pool_bind = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_bind * src * max(0.0, 1.0 - tgt / _max_pool_bind)
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "phosphorylation":
            # Michaelis-Menten（GSK3β 磷酸化 β-catenin）
            k_cat = _get_param(tgt_name, "k_cat", 0.1)
            Km = _get_param(tgt_name, "Km", 0.1)
            # [RC25c] 0.001→0.05: 防止磷酸化形式质量爆炸（半衰期从 693min 降至 14min）
            k_dephos = _get_param(tgt_name, "k_dephos", 0.05)
            modifiers = edge.get("modifiers", [])
            _enzyme_idx = SP_IDX.get(modifiers[0]) if modifiers else None
            _enzyme_conc = max(float(y[_enzyme_idx]), 0.0) if _enzyme_idx is not None else 0.1
            _Vmax = k_cat * _enzyme_conc
            _rate = _Vmax * src / (Km + src) if (Km + src) > 0 else 0.0
            sub_idx = s_idx  # [RC25e] 记录底物索引用于去磷酸化回流
            dy[s_idx] -= _rate
            dy[t_idx] += _rate
            # [RC25e] 修复质量泄漏：去磷酸化产物必须返回底物池
            _dephos_rate = k_dephos * tgt
            dy[t_idx] -= _dephos_rate
            dy[sub_idx] += _dephos_rate  # 去磷酸化产物返回底物池

        elif mechanism == "ubiquitination":
            # 泛素化（E3 连接酶 β-TrCP）
            k_ubi = _get_param(tgt_name, "k_ubi", 0.1)
            Km_ubi = _get_param(tgt_name, "Km_ubi", 0.5)
            _rate = k_ubi * src * tgt / (Km_ubi + tgt) if (Km_ubi + tgt) > 0 else 0.0
            dy[t_idx] -= _rate

        elif mechanism == "degradation":
            # [BENCHMARK CLOSURE / Gap 1] 新增 degradation 分支
            # 生物语义：source → ∅（一级 mass-action 衰减）。
            # target 是 sink（∅ 或未注册的降解产物池），不写入 dy[t_idx]。
            k_deg = _get_param(tgt_name, "degradation", _get_param(tgt_name, "k_deg", None))
            if k_deg is None:
                k_deg = _get_param(src_name, "degradation", _get_param(src_name, "k_deg", 0.05))
            _rate = k_deg * src
            dy[s_idx] -= _rate
            if t_idx >= 0:
                dy[t_idx] += _rate

        elif mechanism == "proteasomal_degradation":
            # 蛋白酶体降解
            k_deg = _get_param(
                tgt_name, "degradation", _get_param(tgt_name, "k_deg", 0.01)
            )
            _rate = k_deg * src
            dy[s_idx] -= _rate

        elif mechanism == "transcription":
            # RCA-3: τ 分钟前的 nuclear β-catenin/TCF state drives AXIN2 mRNA.
            src_eff = y_delayed[s_idx]
            k_trans = _get_param(
                tgt_name, "k_transcription", _get_param(tgt_name, "k_trans", 0.1)
            )
            n_hill = _get_param(tgt_name, "n_hill", 2.0)
            K_d = _get_param(tgt_name, "K_d", 0.5)
            k_mRNA_deg = _get_param(tgt_name, "k_mRNA_deg", 0.01)
            _hill = (src_eff ** n_hill) / (K_d ** n_hill + src_eff ** n_hill) if (K_d ** n_hill + src_eff ** n_hill) > 0 else 0.0
            # [RC25f] logistic 饱和：防止 mRNA 无限累积
            _max_mRNA = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_trans * _hill * max(0.0, 1.0 - tgt / _max_mRNA)
            dy[t_idx] += _rate
            dy[t_idx] -= k_mRNA_deg * tgt

        elif mechanism == "translation":
            k_transl = _get_param(
                tgt_name, "k_translation", _get_param(tgt_name, "k_transl", 0.05)
            )
            k_prot_deg = _get_param(tgt_name, "k_prot_deg", 0.005)
            # [RC25f] logistic 饱和：防止蛋白无限累积
            _max_prot = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_transl * src * max(0.0, 1.0 - tgt / _max_prot)
            dy[t_idx] += _rate
            dy[t_idx] -= k_prot_deg * tgt

        elif mechanism == "nuclear_import":
            k_import = _get_param(tgt_name, "k_import", 0.1)
            _rate = k_import * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "inhibition":
            k_inhib = _get_param(tgt_name, "k_inhib", 0.05)
            _rate = k_inhib * src * tgt
            dy[t_idx] -= _rate

        elif mechanism == "activation":
            # [BENCHMARK CLOSURE / Gap-NumericalExplosion] 修复：旧代码 dy[t_idx] += k_act * src
            #   无饱和、无守恒、无降解，导致 WNT 544K× 数值爆炸。
            #   修复（与 oscillatory_feedback.j2 对齐）：
            #     1. logistic 饱和防止单调递增
            #     2. 消耗未激活前体实现质量守恒
            #     3. k_deg 降解回流到未激活形式
            k_act = _get_param(tgt_name, "k_act", 0.05)
            k_deg = _get_param(tgt_name, "k_deg", 0.02)
            _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 3.0
            _rate = k_act * src * max(0.0, 1.0 - tgt / _max_pool)
            _unphospho_name = tgt_name[1:] if (tgt_name.startswith("p") and len(tgt_name) > 1) else ""
            if _unphospho_name and _unphospho_name in SP_IDX:
                _unphos_idx = SP_IDX[_unphospho_name]
                dy[_unphos_idx] -= _rate
                dy[t_idx] += _rate
                dy[t_idx] -= k_deg * tgt
                dy[_unphos_idx] += k_deg * tgt
            else:
                # 无明确前体：仅 logistic 饱和生产（防止无界增长）
                dy[t_idx] += _rate
                dy[t_idx] -= k_deg * tgt

        else:
            k_default = _get_param(tgt_name, "k", 0.01)
            _rate = k_default * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

    # [P0-B + P1-9 修复] bCatenin 释放项：Wnt 信号驱动 bCatenin 累积。
    # 根因：旧模型 bCatenin 无生产项，仅被 nuclear_import 消耗，fold=1.0（C6 失败）。
    # 生物学依据（Clevers 2006, PMID:17081971; Stamos 2013, PMID:23169527）：
    #   - Wnt 信号 → pLRP6 招募 Axin → destruction complex 解离
    #   - 解离后 bCatenin 逃逸降解，累积入核转录
    #   - bCatenin 累积水平可达 3-10 倍（Western blot 定量）
    # 修复策略（P1-9 V2）：
    #   1. 释放驱动信号优先用 destruction_complex_disrupted；
    #      若 dcd=0（初始态），回退用 pLRP6/pDvl（Wnt 信号直接驱动）
    #   2. 守恒池乘数 *10.0（P1-9: 5.0→10.0）允许充分累积
    #   3. 释放速率 _k_release=2.0（P1-9: 0.5→2.0）补偿 nuclear_import+TCF_LEF 消耗
    #   4. logistic 饱和防止无界增长
    # 预期：bCatenin peak ∈ [0.15, 0.5] nM, fold=peak/0.05 ∈ [3, 10]（C6 通过）
    _bcat_idx = -1
    _dcd_idx = -1  # destruction_complex_disrupted
    _plrp6_idx = -1  # pLRP6（Wnt 信号驱动）
    _pdvl_idx = -1   # pDvl（Wnt 信号驱动）
    for _i, _name in enumerate(SPECIES_NAMES):
        _lower = _name.lower()
        if _bcat_idx < 0 and (
            "bcat" in _lower or "beta_cat" in _lower or _lower == "bcatenin"
        ):
            _bcat_idx = _i
        if _dcd_idx < 0 and (
            "destruction_complex_disrupted" in _lower or "dc_disrupted" in _lower
        ):
            _dcd_idx = _i
        if _plrp6_idx < 0 and ("plrp6" in _lower or "p_lrp6" in _lower or "lrp6_phos" in _lower):
            _plrp6_idx = _i
        if _pdvl_idx < 0 and ("pdvl" in _lower or "p_dvl" in _lower or "dvl_phos" in _lower):
            _pdvl_idx = _i
    if _bcat_idx >= 0:
        # 驱动信号：优先 dcd，否则回退 pLRP6/pDvl（Wnt 信号直接驱动）
        _driver = 0.0
        if _dcd_idx >= 0:
            _driver = max(_driver, y[_dcd_idx])
        if _plrp6_idx >= 0:
            _driver = max(_driver, y[_plrp6_idx])
        if _pdvl_idx >= 0:
            _driver = max(_driver, y[_pdvl_idx])
        _k_release = 5.0  # [P0-FIX] 3.0→5.0: bCatenin fold=2.19（3.0 不足）
        #   根因：SBML k10=206（nuclear_import）/ k16=500（TCF_LEF binding）极快，
        #   bCatenin 被快速消耗到下游池（nuclear+TCF_LEF 总=0.587>>cytosolic=0.110）。
        #   3.0 的释放速率不足以抵消消耗，bCatenin fold=2.19<3（C6 失败）。
        #   5.0 提升释放速率 ~1.67x，预期 bCatenin fold≥3（C6 通过）。
        _max_pool = max(Y0[_bcat_idx] if _bcat_idx < len(Y0) else 0.1, 0.1) * 10.0  # [P1-9] 5.0→10.0
        _avail = max(0.0, _max_pool - y[_bcat_idx])
        _release_rate = _k_release * _driver * _avail / _max_pool
        dy[_bcat_idx] += _release_rate

    return dy


def detect_bcatenin_steady_state(t_arr, y_arr, threshold_nM=10.0):
    """检测 β-catenin 稳态水平（Lee 2003 benchmark）。

    判定规则：
      - 找到 β-catenin 物种（含 beta_cat 或 bcat）
      - 检查稳态（最终值）是否 < 10 nM（无 Wnt 时）
    """
    bcat_idx = -1
    for i, name in enumerate(SPECIES_NAMES):
        lower = name.lower()
        if "beta_cat" in lower or "bcat" in lower or lower == "beta_catenin":
            bcat_idx = i
            break

    if bcat_idx < 0:
        return {"bcatenin_detected": False}

    bcat_series = y_arr[:, bcat_idx]
    bcat_steady = float(bcat_series[-1])
    bcat_max = float(np.max(bcat_series))

    return {
        "bcatenin_detected": True,
        "bcatenin_species": SPECIES_NAMES[bcat_idx],
        "steady_state_nM": bcat_steady,
        "max_value_nM": bcat_max,
        "below_threshold": bcat_steady < threshold_nM,
        "threshold_nM": threshold_nM,
    }


# =============================================================================
# 主程序
# =============================================================================
if __name__ == "__main__":
    # [BM 修复] Y0 全零保护：若无初始扰动则注入默认值，避免仿真输出全零
    _y0_arr = np.asarray(Y0, dtype=float)
    if np.all(_y0_arr == 0.0) and N_SP > 0:
        print("[v4] WARNING: Y0 全零，注入默认扰动（Y0[0]=1.0）以驱动仿真")
        Y0 = list(_y0_arr)
        Y0[0] = 1.0

    t_eval = np.linspace(0, T_END, N_EVAL)
    if REQUIRES_DDE and DDE_DELAY > 0 and is_dde_available():
        print(f"[v4] RCA-3: solve Wnt AXIN2 feedback with DDE tau={DDE_DELAY} min")
        dde_result = solve_dde(
            rhs=_ode_rhs,
            t_span=(0, T_END),
            y0=Y0,
            delay=DDE_DELAY,
            t_eval=t_eval,
            max_step=MAX_STEP_MEDIUM,
            rtol=1e-6,
            atol=1e-9,
        )
        t_arr = np.asarray(dde_result["t"])
        y_arr = np.asarray(dde_result["y"])
        _dde_used = bool(dde_result.get("dde_used", False))
    else:
        if REQUIRES_DDE and DDE_DELAY > 0:
            print(f"[v4] RCA-3 DOWNGRADE: DDE tau={DDE_DELAY} min unavailable; using ODE")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=MAX_STEP_MEDIUM, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False

    # [RCA-38 P0 修复 RC-2] C3 非负性修复：clamp 负浓度（生物学无意义）
    y_arr = np.maximum(y_arr, 0.0)

    # [BM 修复] 生成 simulation.csv + simulation.png（sandbox.py 要求）
    try:
        header = "t," + ",".join(SPECIES_NAMES)
        data = np.column_stack([t_arr, y_arr])
        np.savetxt("simulation.csv", data, delimiter=",", header=header, comments="")

        fig, ax = plt.subplots(figsize=(10, 6))
        for i, sp in enumerate(SPECIES_NAMES):
            if i < y_arr.shape[1]:
                ax.plot(t_arr, y_arr[:, i], label=sp, linewidth=1.5)
        ax.set_xlabel("Time")
        ax.set_ylabel("Concentration")
        ax.set_title("Simulation")
        ax.legend(loc="upper right", fontsize=8)
        ax.grid(alpha=0.3)
        fig.tight_layout()
        fig.savefig("simulation.png", dpi=120)
        plt.close(fig)
    except Exception as _e:
        print(f"[v4] CSV/PNG 生成失败: {_e}")

    # BIO_CHECK 终态输出（sandbox 生物学检查）
    for i, sp in enumerate(SPECIES_NAMES):
        if i < y_arr.shape[1]:
            val = float(y_arr[-1, i])
            safe_val = max(val, 0.0) if np.isfinite(val) else 0.0
            print(f"BIO_CHECK: {sp} = {safe_val:.4f}")

    # BIO_CHECK: simulation_complete, n_species=N_SP, n_steps=len(t_eval)
    # BIO_CHECK: max_conc={max(y_arr[:,i]) for i in range(N_SP)}
    # BIO_CHECK: min_conc={min(y_arr[:,i]) for i in range(N_SP)}
    print(f"# BIO_CHECK: simulation_complete, n_species={N_SP}, n_steps={len(t_eval)}")
    print(f"# BIO_CHECK: max_conc={[float(np.max(y_arr[:, i])) for i in range(N_SP)]}")
    print(f"# BIO_CHECK: min_conc={[float(np.min(y_arr[:, i])) for i in range(N_SP)]}")

    ss_result = detect_bcatenin_steady_state(t_arr, y_arr)

    import json
    result = {
        "species_names": SPECIES_NAMES,
        "time_points": t_arr.tolist(),
        "concentrations": y_arr.tolist(),
        "bcatenin_steady_state": ss_result,
        "dde_delay_minutes": DDE_DELAY,
        "requires_dde": REQUIRES_DDE,
        "dde_used": _dde_used,
    }
    print(json.dumps(result, default=str))
