{# v4 ODE Template: 转录因子模板（Transcription Factor Template）
   对应 PART C5 + 审计 §3.2 无 transcription + §3.6 无 compartment。

   适用通路：
     - JAK_STAT (STAT 转录因子)
     - TGF_beta (SMAD 转录因子)
     - Wnt (β-catenin/TCF 转录因子)
     - NF_kB (NF-κB 转录因子)

   关键特性：
     1. 转录因子激活（磷酸化/二聚化/入核）
     2. Hill 函数转录（n=1-4）
     3. 靶基因转录 + 翻译
     4. 负反馈（SOCS/SMAD7/IκBα/Axin2）

   参数：
     - SPECIES_NAMES: 物种列表
     - EDGES: 反应边列表
     - PARAMS: 每个物种的动力学参数
     - T_END: 仿真总时长（分钟）
     - DDE_DELAY: 转录延迟（分钟）
#}
"""
ODE 仿真（v4 转录因子模板）— Transcription Factor Template
- 适用：STAT / SMAD / β-catenin / NF-κB 等转录因子通路
- Hill 函数转录 + 靶基因表达 + 负反馈
- 支持 DDE（转录延迟）

对应审计修复：
  §3.2 无 transcription → 新增 Hill 函数转录
  §3.6 无 compartment → 新增核质运输
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
EDGES = {{ edges_json }}
PARAMS = {{ params_json }}
DDE_DELAY = {{ dde_delay_minutes }}
REQUIRES_DDE = {{ requires_dde | default(false) }}
PATHWAY_CLASS = "{{ pathway_class | default('') }}"

N_SP = len(SPECIES_NAMES)
SP_IDX = {name: i for i, name in enumerate(SPECIES_NAMES)}

MAX_STEP_FAST = 0.1
MAX_STEP_MEDIUM = 0.5

# =============================================================================
# DDE 求解器（TD-009 模式：从 app.solvers.dde_solver 导入）
# [v5 Recovery Sprint 1 / RC1] DDE 接线，参照 transcriptional_delay.j2 TD-009
# 旧实现: jitcdde try-import 但主程序直接走 solve_ivp（死代码，延迟失效）
# 修复: 使用 app.solvers.dde_solver.solve_dde 真实调用 DDE 求解器
# =============================================================================
from app.solvers.dde_solver import solve_dde, is_dde_available
_JITCDDE_AVAILABLE = is_dde_available()


def _get_param(target_name, param_key, default):
    """从 PARAMS 中获取指定 target 的参数值。"""
    eparams = PARAMS.get(target_name, {})
    return eparams.get(param_key, default)


# [RC25g] 去重预计算：对同一 (source, target) 对，若已有非 activation 机制，
# 则跳过 activation 边，防止 LLM activation 边与 specialist phosphorylation 边重复创建产物
_skip_edge_indices: set[int] = set()
_pair_best_mech: dict[tuple[str, str], str] = {}
_pair_best_idx: dict[tuple[str, str], int] = {}
for _i, _e in enumerate(EDGES):
    _pair = (_e.get("source", ""), _e.get("target", ""))
    _mech = (_e.get("mechanism") or "activation").lower()
    if _pair in _pair_best_mech:
        _prev_mech = _pair_best_mech[_pair]
        if _prev_mech != "activation" and _mech == "activation":
            _skip_edge_indices.add(_i)
        elif _prev_mech == "activation" and _mech != "activation":
            _skip_edge_indices.add(_pair_best_idx[_pair])
            _pair_best_mech[_pair] = _mech
            _pair_best_idx[_pair] = _i
    else:
        _pair_best_mech[_pair] = _mech
        _pair_best_idx[_pair] = _i
if _skip_edge_indices:
    print(f"[RC25g] 跳过 {len(_skip_edge_indices)} 条重复 activation 边")


# [BENCHMARK CLOSURE / Gap-TGF_BETA-SecondRoundDedup] 第二轮去重：对磷酸化形式 target (pX)
# 跨 source 去重，prefer phosphorylation 机制 over activation。
# 根因：LLM 生成 (TbRI→pSmad2, activation) + specialist 生成 (Smad2→pSmad2, phosphorylation)
# 不同 source 但相同 target pSmad2，两条边都消耗 Smad2 + 产生 pSmad2（双重计算），
# 导致 Smad2 被抽干至负值（AUC=-470），触发 C7 Negative Concentration 失败。
# 修复：从 oscillatory_feedback.j2 第 99-121 行同步第二轮去重逻辑。
_tgt_best_mech: dict[str, str] = {}
_tgt_best_idx: dict[str, int] = {}
for _i, _e in enumerate(EDGES):
    if _i in _skip_edge_indices:
        continue  # 已在第一轮被跳过
    _tgt = _e.get("target", "")
    _mech = (_e.get("mechanism") or "activation").lower()
    # 仅对磷酸化形式 target 启用跨 source 去重（pX, p开头且长度>1）
    if not (_tgt.startswith("p") and len(_tgt) > 1):
        continue
    if _tgt in _tgt_best_mech:
        _prev_mech = _tgt_best_mech[_tgt]
        if _prev_mech == "phosphorylation" and _mech == "activation":
            # 已有 phosphorylation 边，当前 activation 边跳过（避免双重 pX 生产）
            _skip_edge_indices.add(_i)
        elif _prev_mech == "activation" and _mech == "phosphorylation":
            # 当前 phosphorylation 边更优，跳过之前的 activation 边
            _skip_edge_indices.add(_tgt_best_idx[_tgt])
            _tgt_best_mech[_tgt] = _mech
            _tgt_best_idx[_tgt] = _i
    else:
        _tgt_best_mech[_tgt] = _mech
        _tgt_best_idx[_tgt] = _i

if len(_skip_edge_indices) > 0:
    print(f"[Gap-TGF_BETA-SecondRoundDedup] 第二轮去重后共跳过 {len(_skip_edge_indices)} 条边")


def _ode_rhs(t, y, y_delayed=None):
    """ODE 右端函数（转录因子模板，支持 DDE 延迟状态）。

    [v5 Recovery Sprint 1 / RC1] 参照 TD-009 模式，新增 y_delayed 参数。
    - ODE 模式（y_delayed=None）：y(t-τ) ≈ y(t)，转录用当前 TF 浓度
    - DDE 模式（y_delayed 提供值）：转录使用 y_delayed（即 y(t-τ)）作为 TF 浓度
    """
    dy = np.zeros(N_SP)
    y = np.maximum(y, 0.0)  # TD-001 修复：负浓度保护（防 Hill src**n 对负底数产生 NaN）
    # [v5 RC1] DDE 模式下使用延迟状态；ODE 模式下 y_delayed = y
    if y_delayed is None:
        y_delayed = y
    else:
        y_delayed = np.maximum(y_delayed, 0.0)
    for _edge_idx, edge in enumerate(EDGES):
        if _edge_idx in _skip_edge_indices:  # [RC25g] 跳过重复 activation 边
            continue
        src_name = edge.get("source", "")
        tgt_name = edge.get("target", "")
        mechanism = edge.get("mechanism", "activation")
        # [BENCHMARK CLOSURE / Gap-TGF_BETA-TranscriptionSkip] 修复：transcription/translation
        #   边的 source 为空（TF/mRNA 作 modifier），从 modifiers[0] 获取实际源物种。
        #   旧 BUG：transcription 边 source="" 不在 SP_IDX，触发 continue 静默跳过，
        #   导致 PAI1_mRNA/SMAD7_mRNA 永不产生 → 转录级联断裂。
        #   修复：参照 oscillatory_feedback.j2 第 161-165 行同步回填逻辑。
        if not src_name and mechanism in ("transcription", "translation"):
            _mods = edge.get("modifiers", [])
            if _mods:
                src_name = _mods[0]
                edge["source"] = src_name  # 回写供后续逻辑使用
        # [BENCHMARK CLOSURE / Gap 1] 修复：degradation 类机制（degradation /
        # proteasomal_degradation）的 target 是 sink（∅ 或未注册的降解产物池）。
        # 仅要求 source 在 SP_IDX；target 缺失时，不写入 dy[t_idx]，仅消耗 source。
        # 旧逻辑：`if src_name not in SP_IDX or tgt_name not in SP_IDX: continue`
        # 静默丢弃所有 target 未注册的 degradation 边 → 物种永不衰减 → 数值爆炸。
        _mech_lower = (mechanism or "activation").lower()
        _is_sink_mechanism = _mech_lower in ("degradation", "proteasomal_degradation")
        if src_name not in SP_IDX:
            continue
        if not _is_sink_mechanism and tgt_name not in SP_IDX:
            continue
        s_idx = SP_IDX[src_name]
        t_idx = SP_IDX.get(tgt_name, -1)
        src = y[s_idx]
        tgt = y[t_idx] if t_idx >= 0 else 0.0

        if mechanism == "transcription":
            # 转录（Hill 函数，默认 n=2，含延迟）
            # [v5 RC1] DDE: 使用 y_delayed[s_idx] 作为 TF 浓度（τ 分钟前的 TF 驱动当前 mRNA 转录）
            k_trans = _get_param(tgt_name, "k_trans", 0.1)
            n_hill = _get_param(tgt_name, "n_hill", 2.0)
            K_d = _get_param(tgt_name, "K_d", 0.5)
            k_mRNA_deg = _get_param(tgt_name, "k_mRNA_deg", 0.01)
            # Hill 函数：v = k_trans * [TF(t-τ)]^n / (K_d^n + [TF(t-τ)]^n)
            src_eff = y_delayed[s_idx]  # DDE: TF 用延迟状态
            _hill = (src_eff ** n_hill) / (K_d ** n_hill + src_eff ** n_hill) if (K_d ** n_hill + src_eff ** n_hill) > 0 else 0.0
            # [RC25f] logistic 饱和：防止 mRNA 无限累积
            _max_mRNA = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_trans * _hill * max(0.0, 1.0 - tgt / _max_mRNA)
            dy[t_idx] += _rate
            dy[t_idx] -= k_mRNA_deg * tgt

        elif mechanism == "translation":
            # 翻译（mRNA → 蛋白）
            k_transl = _get_param(tgt_name, "k_transl", 0.05)
            k_prot_deg = _get_param(tgt_name, "k_prot_deg", 0.005)
            # [RC25f] logistic 饱和：防止蛋白无限累积
            _max_prot = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_transl * src * max(0.0, 1.0 - tgt / _max_prot)
            dy[t_idx] += _rate
            dy[t_idx] -= k_prot_deg * tgt

        elif mechanism == "phosphorylation":
            # TF 磷酸化激活（Michaelis-Menten）
            k_cat = _get_param(tgt_name, "k_cat", 0.1)
            Km = _get_param(tgt_name, "Km", 0.1)
            # [RC25c] 0.001→0.05: 防止磷酸化形式质量爆炸（半衰期从 693min 降至 14min）
            k_dephos = _get_param(tgt_name, "k_dephos", 0.05)
            # [RC25h] 自磷酸化：使用固定激酶活性，避免自催化正反馈
            _enzyme_conc = 0.1  # 等效外源激酶浓度（nM）
            _Vmax = k_cat * _enzyme_conc
            _rate = _Vmax * src / (Km + src) if (Km + src) > 0 else 0.0
            sub_idx = s_idx  # [RC25e] 记录底物索引用于去磷酸化回流
            dy[s_idx] -= _rate
            dy[t_idx] += _rate
            # [RC25e] 修复质量泄漏：去磷酸化产物必须返回底物池
            _dephos_rate = k_dephos * tgt
            dy[t_idx] -= _dephos_rate
            dy[sub_idx] += _dephos_rate  # 去磷酸化产物返回底物池

        elif mechanism == "dimerization":
            # TF 二聚化（mass-action 2A → A2）
            k_dim = _get_param(tgt_name, "k_dim", 0.1)
            _rate = k_dim * src * src
            dy[s_idx] -= 2 * _rate
            dy[t_idx] += _rate

        elif mechanism == "complex_formation":
            # 异源复合（R-SMAD + Co-SMAD）
            # [BENCHMARK CLOSURE / Gap-TGF_BETA-ComplexNoDissociation] 修复：旧实现无饱和限制，
            #   复合物单调累积至仿真终点未达峰（TGF_beta_TbRII_TbRI 3.0x at 240min）。
            #   修复：添加 logistic 饱和限制（与 activation/transcription 分支一致）。
            k_form = _get_param(tgt_name, "k_form", 0.1)
            _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_form * src * max(0.0, 1.0 - tgt / _max_pool)
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "nuclear_import":
            # TF 入核
            k_import = _get_param(tgt_name, "k_import", 0.1)
            _rate = k_import * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "nuclear_export":
            # TF 出核（负反馈）
            k_export = _get_param(tgt_name, "k_export", 0.05)
            _rate = k_export * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "ubiquitination":
            # 泛素化（SMAD7→SMURF 途径）
            k_ubi = _get_param(tgt_name, "k_ubi", 0.1)
            Km_ubi = _get_param(tgt_name, "Km_ubi", 0.5)
            _rate = k_ubi * src * tgt / (Km_ubi + tgt) if (Km_ubi + tgt) > 0 else 0.0
            dy[t_idx] -= _rate

        elif mechanism == "degradation":
            # [BENCHMARK CLOSURE / Gap 1] 新增 degradation 分支
            # 生物语义：source → ∅（一级 mass-action 衰减）。
            # target 是 sink（∅ 或未注册的降解产物池），不写入 dy[t_idx]。
            k_deg = _get_param(tgt_name, "k_deg", None)
            if k_deg is None:
                k_deg = _get_param(src_name, "k_deg", 0.05)
            _rate = k_deg * src
            dy[s_idx] -= _rate
            if t_idx >= 0:
                dy[t_idx] += _rate

        elif mechanism == "proteasomal_degradation":
            k_deg = _get_param(tgt_name, "k_deg", 0.01)
            _rate = k_deg * src
            dy[s_idx] -= _rate

        elif mechanism == "inhibition":
            # 负反馈抑制（SOCS/SMAD7/IκBα）
            k_inhib = _get_param(tgt_name, "k_inhib", 0.05)
            _rate = k_inhib * src * tgt
            dy[t_idx] -= _rate

        elif mechanism == "activation":
            # [BENCHMARK CLOSURE / Gap-NumericalExplosion] 修复：旧代码无饱和无守恒
            #   修复（与 oscillatory_feedback.j2 对齐）：logistic 饱和 + 守恒 + k_deg 回流
            # [BENCHMARK CLOSURE / Gap-TGF_BETA-ActivationMassCreation] 修复 else 分支：
            #   旧 BUG：target 为非磷酸化形式（TbRII/TbRI/SMAD7_mRNA）时走 else 分支，
            #   dy[tgt] += _rate 不消耗 source，质量凭空创造（TbRII 增至 1.364x）。
            #   修复：非磷酸化 target 也应消耗 source（信号传递需质量转移），
            #   同时保留 k_deg 降解使 target 有衰减动态。
            k_act = _get_param(tgt_name, "k_act", 0.05)
            k_deg = _get_param(tgt_name, "k_deg", 0.02)
            _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 3.0
            _rate = k_act * src * max(0.0, 1.0 - tgt / _max_pool)
            _unphospho_name = tgt_name[1:] if (tgt_name.startswith("p") and len(tgt_name) > 1) else ""
            if _unphospho_name and _unphospho_name in SP_IDX:
                _unphos_idx = SP_IDX[_unphospho_name]
                dy[_unphos_idx] -= _rate
                dy[t_idx] += _rate
                dy[t_idx] -= k_deg * tgt
                dy[_unphos_idx] += k_deg * tgt
            else:
                # [BENCHMARK CLOSURE / Gap-TGF_BETA-ActivationMassCreation] 修复：
                #   消耗 source（信号传递需质量转移），不再凭空创造 target。
                dy[s_idx] -= _rate
                dy[t_idx] += _rate
                dy[t_idx] -= k_deg * tgt

        else:
            k_default = _get_param(tgt_name, "k", 0.01)
            _rate = k_default * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

    return dy


def detect_tf_activation(t_arr, y_arr):
    """检测转录因子激活动力学。

    判定规则：
      - 找到磷酸化/活性形式（p 前缀或 _active 后缀）
      - 检测峰值时间（5-15 min 达峰）
      - 检测 mRNA 延迟（30-60 min）
    """
    tf_active_idx = -1
    mrna_idx = -1
    for i, name in enumerate(SPECIES_NAMES):
        if (name.startswith("p") or name.endswith("_active")) and tf_active_idx < 0:
            tf_active_idx = i
        if name.endswith("_mRNA") and mrna_idx < 0:
            mrna_idx = i

    result = {
        "tf_active_detected": tf_active_idx >= 0,
        "mrna_detected": mrna_idx >= 0,
    }

    if tf_active_idx >= 0:
        tf_series = y_arr[:, tf_active_idx]
        tf_peak_time = float(t_arr[int(np.argmax(tf_series))])
        tf_peak = float(np.max(tf_series))
        result["tf_peak_time"] = tf_peak_time
        result["tf_peak_value"] = tf_peak
        # 5-15 min 达峰判定
        result["peak_in_5_15_min"] = 5.0 <= tf_peak_time <= 15.0

    if mrna_idx >= 0:
        mrna_series = y_arr[:, mrna_idx]
        mrna_peak_time = float(t_arr[int(np.argmax(mrna_series))])
        result["mrna_peak_time"] = mrna_peak_time
        # 30-60 min 延迟判定
        result["mrna_delay_30_60_min"] = 30.0 <= mrna_peak_time <= 60.0

    if tf_active_idx >= 0 and mrna_idx >= 0:
        result["mrna_after_tf_minutes"] = result["mrna_peak_time"] - result["tf_peak_time"]

    return result


# =============================================================================
# 求解器选择（TD-009 模式：三分支 DDE 求解）
# =============================================================================
def solve_tf():
    """求解转录因子通路。

    [v5 Recovery Sprint 1 / RC1] DDE 接线，参照 TD-009 模式。
    三分支：
      1. DDE_DELAY > 0 且 DDE 可用 → 调用 solve_dde 真实 DDE 求解
      2. DDE_DELAY > 0 但 DDE 不可用 → 降级为 ODE + 打印警告
      3. 无延迟 → 正常 ODE 求解

    Returns:
        (t_arr, y_arr, dde_used): 时间序列、状态序列、是否使用了 DDE
    """
    t_eval = np.linspace(0, T_END, N_EVAL)

    if DDE_DELAY > 0 and is_dde_available():
        # 分支1：延迟 > 0 且 DDE 可用 → 调用 solve_dde 真实 DDE 求解
        print(f"[v5] RC1: 调用 solve_dde 真实 DDE 求解（τ={DDE_DELAY} min）")
        dde_result = solve_dde(
            rhs=_ode_rhs,
            t_span=(0, T_END),
            y0=Y0,
            delay=DDE_DELAY,
            t_eval=t_eval,
            max_step=MAX_STEP_MEDIUM,
        )
        t_arr = np.asarray(dde_result["t"])
        y_arr = np.asarray(dde_result["y"])
        _dde_used = dde_result.get("dde_used", True)
    elif DDE_DELAY > 0 and not is_dde_available():
        # 分支2：延迟 > 0 但 DDE 不可用 → 降级为 ODE + 打印警告
        print(f"[v5] RC1 DOWNGRADE WARNING: jitcdde 不可用，"
              f"DDE 延迟 τ={DDE_DELAY} min 失效（y(t-τ)≈y(t)），降级为 ODE 求解")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=MAX_STEP_MEDIUM, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False
    else:
        # 分支3：无延迟 → 正常 ODE 求解
        print(f"[v5] RC1: 无延迟（DDE_DELAY=0），使用 ODE 求解")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=MAX_STEP_MEDIUM, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False

    return t_arr, y_arr, _dde_used


# =============================================================================
# 主程序
# =============================================================================
if __name__ == "__main__":
    # [BM 修复] Y0 全零保护：若无初始扰动则注入默认值，避免仿真输出全零
    _y0_arr = np.asarray(Y0, dtype=float)
    if np.all(_y0_arr == 0.0) and N_SP > 0:
        print("[v4] WARNING: Y0 全零，注入默认扰动（Y0[0]=1.0）以驱动仿真")
        Y0 = list(_y0_arr)
        Y0[0] = 1.0

    # [v5 Recovery Sprint 1 / RC1] 主程序使用 3 值返回签名 (t, y, dde_used)
    t_arr, y_arr, _dde_used = solve_tf()

    # BIO_CHECK: simulation_complete, n_species=N_SP, n_steps=len(t_arr)
    # BIO_CHECK: max_conc={max(y_arr[:,i]) for i in range(N_SP)}
    # BIO_CHECK: min_conc={min(y_arr[:,i]) for i in range(N_SP)}
    print(f"# BIO_CHECK: simulation_complete, n_species={N_SP}, n_steps={len(t_arr)}")
    print(f"# BIO_CHECK: max_conc={[float(np.max(y_arr[:, i])) for i in range(N_SP)]}")
    print(f"# BIO_CHECK: min_conc={[float(np.min(y_arr[:, i])) for i in range(N_SP)]}")

    # [BM 修复] 生成 simulation.csv + simulation.png（sandbox.py 要求）
    try:
        header = "t," + ",".join(SPECIES_NAMES)
        data = np.column_stack([t_arr, y_arr])
        np.savetxt("simulation.csv", data, delimiter=",", header=header, comments="")

        fig, ax = plt.subplots(figsize=(10, 6))
        for i, sp in enumerate(SPECIES_NAMES):
            if i < y_arr.shape[1]:
                ax.plot(t_arr, y_arr[:, i], label=sp, linewidth=1.5)
        ax.set_xlabel("Time")
        ax.set_ylabel("Concentration")
        ax.set_title("Simulation: Transcription Factor")
        ax.legend(loc="upper right", fontsize=8)
        ax.grid(alpha=0.3)
        fig.tight_layout()
        fig.savefig("simulation.png", dpi=120)
        plt.close(fig)
    except Exception as _e:
        print(f"[v4] CSV/PNG 生成失败: {_e}")

    # BIO_CHECK 终态输出（sandbox 生物学检查）
    for i, sp in enumerate(SPECIES_NAMES):
        if i < y_arr.shape[1]:
            val = float(y_arr[-1, i])
            safe_val = max(val, 0.0) if np.isfinite(val) else 0.0
            print(f"BIO_CHECK: {sp} = {safe_val:.4f}")

    tf_result = detect_tf_activation(t_arr, y_arr)

    import json
    result = {
        "species_names": SPECIES_NAMES,
        "time_points": t_arr.tolist(),
        "concentrations": y_arr.tolist(),
        "tf_activation": tf_result,
        "dde_delay_minutes": DDE_DELAY,
        "dde_available": _JITCDDE_AVAILABLE,
        "dde_used": _dde_used,
        "requires_dde": REQUIRES_DDE,
    }
    print(json.dumps(result, default=str))
