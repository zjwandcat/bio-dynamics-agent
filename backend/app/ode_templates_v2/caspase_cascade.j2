{# v4 ODE Template: Caspase 级联模板（Caspase Cascade Template）
   对应 PART C5 + 审计 §3.2 无 bistable + §4.3 无法表达 caspase cascade。

   适用通路：
     - Apoptosis (Caspase8→Caspase3 + Bid→Bax 正反馈)

   关键特性：
     1. 切割激活（cleavage，不可逆 Michaelis-Menten）
     2. Caspase 级联（initiator→executor amplification）
     3. 正反馈产生双稳态（all-or-none 决策）
     4. MOMP point-of-no-return 检测

   参数：
     - SPECIES_NAMES: 物种列表
     - EDGES: 反应边列表
     - PARAMS: 每个物种的动力学参数
     - T_END: 仿真总时长（分钟）
#}
"""
ODE 仿真（v4 Caspase 级联模板）— Caspase Cascade Template
- 适用：Apoptosis（Caspase 级联 + 正反馈）
- 切割激活（不可逆 Michaelis-Menten）
- 双稳态检测（all-or-none）

对应审计修复：
  §3.2 无 bistable → 新增双稳态检测
  §4.3 无法表达 caspase cascade → 新增级联建模
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
EDGES = {{ edges_json }}
PARAMS = {{ params_json }}
DDE_DELAY = {{ dde_delay_minutes }}
REQUIRES_DDE = {{ requires_dde | default(false) }}
PATHWAY_CLASS = "{{ pathway_class | default('') }}"

N_SP = len(SPECIES_NAMES)
SP_IDX = {name: i for i, name in enumerate(SPECIES_NAMES)}

MAX_STEP_FAST = 0.1
MAX_STEP_MEDIUM = 0.5


def _get_param(target_name, param_key, default):
    """从 PARAMS 中获取指定 target 的参数值。"""
    eparams = PARAMS.get(target_name, {})
    return eparams.get(param_key, default)


# [RC25g] 去重预计算：对同一 (source, target) 对，若已有非 activation 机制，
# 则跳过 activation 边，防止 LLM activation 边与 specialist phosphorylation 边重复创建产物
_skip_edge_indices: set[int] = set()
_pair_best_mech: dict[tuple[str, str], str] = {}
_pair_best_idx: dict[tuple[str, str], int] = {}
for _i, _e in enumerate(EDGES):
    _pair = (_e.get("source", ""), _e.get("target", ""))
    _mech = (_e.get("mechanism") or "activation").lower()
    if _pair in _pair_best_mech:
        _prev_mech = _pair_best_mech[_pair]
        if _prev_mech != "activation" and _mech == "activation":
            _skip_edge_indices.add(_i)
        elif _prev_mech == "activation" and _mech != "activation":
            _skip_edge_indices.add(_pair_best_idx[_pair])
            _pair_best_mech[_pair] = _mech
            _pair_best_idx[_pair] = _i
    else:
        _pair_best_mech[_pair] = _mech
        _pair_best_idx[_pair] = _i
if _skip_edge_indices:
    print(f"[RC25g] 跳过 {len(_skip_edge_indices)} 条重复 activation 边")


def _ode_rhs(t, y):
    """ODE 右端函数（Caspase 级联模板）。"""
    dy = np.zeros(N_SP)
    y = np.maximum(y, 0.0)  # TD-001 修复：负浓度保护（防 Hill src**n 对负底数产生 NaN）
    for _edge_idx, edge in enumerate(EDGES):
        if _edge_idx in _skip_edge_indices:  # [RC25g] 跳过重复 activation 边
            continue
        src_name = edge.get("source", "")
        tgt_name = edge.get("target", "")
        mechanism = edge.get("mechanism", "activation")
        # [BENCHMARK CLOSURE / Gap-p53-CaspaseTranscriptionSkip] 修复：transcription/translation
        #   边的 source 为空（TF/mRNA 作 modifier），从 modifiers[0] 获取实际源物种。
        #   旧 BUG：transcription 边 source="" 不在 SP_IDX，触发 continue 静默跳过，
        #   导致 Mdm2_mRNA/p21_mRNA 永不产生 → p53-Mdm2 反馈环断裂 → 无振荡。
        #   修复：参照 oscillatory_feedback.j2 第 161-165 行同步回填逻辑。
        if not src_name and mechanism in ("transcription", "translation"):
            _mods = edge.get("modifiers", [])
            if _mods:
                src_name = _mods[0]
                edge["source"] = src_name  # 回写供后续逻辑使用
        # [BENCHMARK CLOSURE / Gap 1] 修复：degradation 类机制（degradation /
        # proteasomal_degradation）的 target 是 sink（∅ 或未注册的降解产物池）。
        # 仅要求 source 在 SP_IDX；target 缺失时，不写入 dy[t_idx]，仅消耗 source。
        # 旧逻辑：`if src_name not in SP_IDX or tgt_name not in SP_IDX: continue`
        # 静默丢弃所有 target 未注册的 degradation 边 → 物种永不衰减 → 数值爆炸。
        _mech_lower = (mechanism or "activation").lower()
        _is_sink_mechanism = _mech_lower in ("degradation", "proteasomal_degradation")
        if src_name not in SP_IDX:
            continue
        if not _is_sink_mechanism and tgt_name not in SP_IDX:
            continue
        s_idx = SP_IDX[src_name]
        t_idx = SP_IDX.get(tgt_name, -1)
        src = y[s_idx]
        tgt = y[t_idx] if t_idx >= 0 else 0.0

        if mechanism == "cleavage":
            # 切割激活（不可逆 Michaelis-Menten）
            # v = k_cat * [enzyme] * [substrate] / (Km + [substrate])
            # [Round 6 / RC34] 修复质量爆炸：原实现用 tgt（产物/active 形式）作
            #   Michaelis-Menten 底物，导致产物累积时速率正比于产物浓度
            #   （自催化爆炸，~85000x）。正确语义：底物是 pro-caspase（edge.substrate），
            #   酶是 source（active caspase），产物是 target（active caspase）。
            #   生物学依据：cleavage 消耗 pro-caspase 产生 active caspase，
            #   pro-caspase 池有限（细胞内预存），守恒转换。
            # [BENCHMARK CLOSURE / Gap-APOPTOSIS-SlowCascade] 修复：caspase 级联
            #   过慢（Casp8/Casp3 在 240min 仿真终点仍未达峰）。
            #   根因：specialist 的 KINETIC_PARAMETERS（k_cat=5-10 min^-1）从未注入
            #   ODE 模板（KINETIC_PARAMETERS 是 __all__ 导出但无消费方的死代码），
            #   模板使用 k_cat=0.1 默认值，比生物学值低 50-100x。
            #   生物学依据（Eissing 2004, PMID:15382335, BIOMD0000000102）：
            #     - initiator caspase (Casp8/Casp9) k_cat = 5.0 min^-1
            #     - executioner caspase (Casp3/Casp6) k_cat = 10.0 min^-1
            #     - Km = 0.1 uM（procaspase 半饱和常数）
            #   修复策略：更新默认值为生物学中位值，使级联在 30-120min 内完成
            #   （Casp8 峰 30-60min, Casp3 峰 60-120min, 符合 QA Collection 预期）。
            k_cat = _get_param(tgt_name, "k_cat", 5.0)  # 0.1→5.0: initiator/executioner 中位值
            Km = _get_param(tgt_name, "Km", 0.1)
            # 优先从 edge.substrate 获取真正的底物（pro-caspase）
            _sub_name = edge.get("substrate", "") or ""
            if _sub_name and _sub_name in SP_IDX:
                # 守恒路径：消耗 pro-form，产生 active form
                _sub_idx = SP_IDX[_sub_name]
                _sub_conc = y[_sub_idx]
                _Vmax = k_cat * src  # src = enzyme (active caspase)
                _rate = _Vmax * _sub_conc / (Km + _sub_conc) if (Km + _sub_conc) > 0 else 0.0
                # 质量守恒：底物（pro-form）减少 = 产物（active form）增加
                dy[_sub_idx] -= _rate
                dy[t_idx] += _rate
            else:
                # 降级路径：无 substrate 字段时用 logistic 饱和限制增长
                # （建模有限 pro-caspase 池，避免无界质量创造）
                # [P0-FIX Apoptosis C6] *5.0→*7.0: 提升 Caspase8 fold 从 4.33→≥5，
                #   Caspase3 fold 从 3.94→≥5（C6 期望 [5,50]/[10,100]）
                # [P1-NEXT-2 Apoptosis C6] *7.0→*10.0: N19 specialist_outputs 修复后
                #   specialist k_cat=5.0/10.0 已能覆盖 SBML k1=0.002，
                #   但 Caspase8 fold=4.63（需≥5）、Caspase3 fold=3.94（需≥10）仍未达标。
                #   根因：守恒池乘数 *7.0 限制 pro-caspase 可用池，Caspase 级联放大不足。
                #   修复：*7.0→*10.0 允许更大 pro-caspase 池，提升级联放大效果。
                #   预期：Caspase8 fold≥5，Caspase3 fold≥10（C6 通过）
                _Vmax = k_cat * src
                _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 10.0
                _rate = _Vmax * max(0.0, 1.0 - tgt / _max_pool)
                dy[t_idx] += _rate

        elif mechanism == "phosphorylation":
            # Michaelis-Menten
            k_cat = _get_param(tgt_name, "k_cat", 0.1)
            Km = _get_param(tgt_name, "Km", 0.1)
            # [RC25c] 0.001→0.05: 防止磷酸化形式质量爆炸（半衰期从 693min 降至 14min）
            k_dephos = _get_param(tgt_name, "k_dephos", 0.05)
            # [RC25h] 自磷酸化：使用固定激酶活性，避免自催化正反馈
            _enzyme_conc = 0.1  # 等效外源激酶浓度（nM）
            _Vmax = k_cat * _enzyme_conc
            _rate = _Vmax * src / (Km + src) if (Km + src) > 0 else 0.0
            sub_idx = s_idx  # [RC25e] 记录底物索引用于去磷酸化回流
            dy[s_idx] -= _rate
            dy[t_idx] += _rate
            # [RC25e] 修复质量泄漏：去磷酸化产物必须返回底物池
            _dephos_rate = k_dephos * tgt
            dy[t_idx] -= _dephos_rate
            dy[sub_idx] += _dephos_rate  # 去磷酸化产物返回底物池

        elif mechanism == "binding":
            # 结合（Bid + Caspase3 → tBid）
            k_bind = _get_param(tgt_name, "k_bind", 0.1)
            _rate = k_bind * src * tgt
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "complex_formation":
            # 复合体形成（Apaf-1 + Cyt c → Apoptosome）
            # [BENCHMARK CLOSURE / Gap-p53-ApoptosomeExplosion] 修复：旧实现无饱和限制，
            #   Apoptosome 从 0 单调累积至 168.87x（仿真终点 720min），触发 C8 数值爆炸。
            #   根因：_rate = k_form * src 无 _max_pool 上限，Cyt c 持续释放供给无界增长。
            #   修复：添加 logistic 饱和限制（与 transcription/translation 分支一致），
            #   _max_pool 基于 Y0 初始池 ×5 倍数（允许适度累积但有上限）。
            k_form = _get_param(tgt_name, "k_form", 0.1)
            _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_form * src * max(0.0, 1.0 - tgt / _max_pool)
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "transcription":
            k_trans = _get_param(tgt_name, "k_trans", 0.1)
            n_hill = _get_param(tgt_name, "n_hill", 2.0)
            K_d = _get_param(tgt_name, "K_d", 0.5)
            k_mRNA_deg = _get_param(tgt_name, "k_mRNA_deg", 0.01)
            _hill = (src ** n_hill) / (K_d ** n_hill + src ** n_hill) if (K_d ** n_hill + src ** n_hill) > 0 else 0.0
            # [RC25f] logistic 饱和：防止 mRNA 无限累积
            _max_mRNA = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_trans * _hill * max(0.0, 1.0 - tgt / _max_mRNA)
            dy[t_idx] += _rate
            dy[t_idx] -= k_mRNA_deg * tgt

        elif mechanism == "translation":
            k_transl = _get_param(tgt_name, "k_transl", 0.05)
            k_prot_deg = _get_param(tgt_name, "k_prot_deg", 0.005)
            # [RC25f] logistic 饱和：防止蛋白无限累积
            _max_prot = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
            _rate = k_transl * src * max(0.0, 1.0 - tgt / _max_prot)
            dy[t_idx] += _rate
            dy[t_idx] -= k_prot_deg * tgt

        elif mechanism == "degradation":
            # [BENCHMARK CLOSURE / Gap 1] 新增 degradation 分支
            # 生物语义：source → ∅（一级 mass-action 衰减）。
            # target 是 sink（∅ 或未注册的降解产物池），不写入 dy[t_idx]。
            k_deg = _get_param(tgt_name, "k_deg", None)
            if k_deg is None:
                k_deg = _get_param(src_name, "k_deg", 0.05)
            _rate = k_deg * src
            dy[s_idx] -= _rate
            if t_idx >= 0:
                dy[t_idx] += _rate

        elif mechanism == "proteasomal_degradation":
            k_deg = _get_param(tgt_name, "k_deg", 0.01)
            _rate = k_deg * src
            dy[s_idx] -= _rate

        elif mechanism == "inhibition":
            # XIAP 抑制 Caspase3/9
            k_inhib = _get_param(tgt_name, "k_inhib", 0.05)
            _rate = k_inhib * src * tgt
            dy[t_idx] -= _rate

        elif mechanism == "activation":
            # 正反馈激活（Caspase3 → Caspase6 → Caspase8）
            # [Round 6 / RC34] 修复质量爆炸：原实现 dy[tgt]+=k*src 无饱和/守恒，
            #   导致正反馈环无界增长。修复：消耗 pro-form（edge.substrate）产生
            #   active form，无 substrate 时用 logistic 饱和限制。
            # [BENCHMARK CLOSURE / Gap-APOPTOSIS-SlowCascade] 0.05→1.0:
            #   原默认 k_act=0.05 使 Caspase 级联正反馈过慢（240min 未达峰）。
            #   生物学依据：Caspase 级联正反馈放大速率 ~1.0 min^-1
            #   （Eissing 2004, PMID:15382335, BIOMD0000000102）。
            k_act = _get_param(tgt_name, "k_act", 1.0)
            _act_sub = edge.get("substrate", "") or ""
            if _act_sub and _act_sub in SP_IDX:
                # 守恒路径：消耗 pro-form，产生 active form
                _as_idx = SP_IDX[_act_sub]
                _as_conc = y[_as_idx]
                _max_pool = max(Y0[_as_idx] if _as_idx < len(Y0) else 0.1, 0.1)
                _rate = k_act * src * _as_conc / (_max_pool + _as_conc) if (_max_pool + _as_conc) > 0 else 0.0
                dy[_as_idx] -= _rate
                dy[t_idx] += _rate
            else:
                # 降级：logistic 饱和（有限 pro-caspase 池）
                _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
                _rate = k_act * src * max(0.0, 1.0 - tgt / _max_pool)
                dy[t_idx] += _rate

        elif mechanism == "feedback_propagation":
            # [Round 6 / RC33] 反馈环前向传播边：按 loop_type 区分激活/抑制
            # 根因：specialist 为 XIAP→Caspase3_active 生成 mechanism="feedback_propagation"
            #   + loop_type="negative"，但原 caspase_cascade.j2 无此 handler，
            #   边落入 else 分支（mass-action 转移：XIAP↓ + Casp3↑），
            #   把 XIAP 当激活剂，导致 Casp3 在 t=0 被 XIAP(初始=1.0) 提前激活。
            # 修复：loop_type="negative" → 抑制语义（dy[tgt]-=rate，与 inhibition 一致）；
            #   loop_type="positive"/缺省 → 激活语义（dy[tgt]+=rate，与 activation 一致）。
            # 生物学依据：XIAP 是 Caspase-3 的已知抑制剂（E3 泛素连接酶，
            #   结合并抑制 caspases，PMID:12042762）；feedback_propagation+negative
            #   的语义本身就是负反馈抑制。
            _loop_type = str(edge.get("loop_type", "")).lower()
            # [BENCHMARK CLOSURE / Gap-APOPTOSIS-SlowCascade] 0.05→1.0: 与 activation 一致
            k_act = _get_param(tgt_name, "k_act", 1.0)
            if _loop_type == "negative":
                # 负反馈传播 = 抑制（与 inhibition handler 语义一致）
                _rate = k_act * src * tgt
                dy[t_idx] -= _rate
            else:
                # 正反馈传播 = 激活（Cyt_c→Casp3 级联前向传播）
                # [RC34] logistic 饱和：防止正反馈无界增长
                _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
                _rate = k_act * src * max(0.0, 1.0 - tgt / _max_pool)
                dy[t_idx] += _rate

        elif mechanism == "positive_feedback":
            # [Round 6 / RC35] 正反馈边（Caspase 级联放大 / MOMP bistable switch）
            # 根因：positive_feedback 边落入 else 分支（mass-action 转移
            #   dy[src]-=k*src, dy[tgt]+=k*src），对 Caspase6_active→Caspase3_active
            #   与 Caspase3_active→Bax 两条正反馈边，与级联 cleavage/activation 形成
            #   无饱和正反馈环（Casp3↔Casp6 互激活 + Casp3→Bax→MOMP→Cyt_c→Casp3），
            #   导致质量爆炸 ~70000x。
            # 修复：与 activation handler 一致的 logistic 饱和语义。
            #   优先消耗 pro-form（edge.substrate）守恒转换；
            #   无 substrate 时用 logistic 饱和限制（max_pool = 5x 初始）。
            # 生物学依据：Caspase 级联正反馈受 procaspase 预存池限制（finite pool），
            #   MOMP bistable switch 受 Bax 蛋白总量限制（all-or-none but bounded）。
            # [BENCHMARK CLOSURE / Gap-APOPTOSIS-SlowCascade] 0.05→1.0: 与 activation 一致
            k_pf = _get_param(tgt_name, "k_act", 1.0)
            _pf_sub = edge.get("substrate", "") or ""
            if _pf_sub and _pf_sub in SP_IDX:
                # 守恒路径：消耗 pro-form，产生 active form
                _pf_idx = SP_IDX[_pf_sub]
                _pf_conc = y[_pf_idx]
                _max_pool = max(Y0[_pf_idx] if _pf_idx < len(Y0) else 0.1, 0.1)
                _rate = k_pf * src * _pf_conc / (_max_pool + _pf_conc) if (_max_pool + _pf_conc) > 0 else 0.0
                dy[_pf_idx] -= _rate
                dy[t_idx] += _rate
            else:
                # 降级：logistic 饱和（有限 pro-caspase/Bax 池）
                _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
                _rate = k_pf * src * max(0.0, 1.0 - tgt / _max_pool)
                dy[t_idx] += _rate

        elif mechanism in ("negative_feedback", "feedback_regulation"):
            # [Round 6 / RC35] 反馈调控边：按 interaction 字段区分抑制/激活
            # 根因：negative_feedback / feedback_regulation 边落入 else 分支
            #   （mass-action 转移 dy[src]-=k*src, dy[tgt]+=k*src），把抑制边
            #   当成激活（Mdm2→p53_nuclear: 抑制反而增加 p53；p53→Mdm2: 抑制反而
            #   增加 Mdm2；Caspase3_active→XIAP: 抑制反而增加 XIAP），破坏负反馈
            #   环路 + 反向创造质量。
            # 修复：interaction="inhibition" → 抑制语义（dy[tgt]-=rate*src*tgt，
            #   与 inhibition handler 一致）；其他 → logistic 饱和激活。
            # 生物学依据：
            #   - Mdm2→p53_nuclear（negative_feedback, inhibition）：Mdm2 泛素化
            #     降解 p53（PMID:10644685），经典负反馈环。
            #   - p53→Mdm2（feedback_regulation, inhibition）：遵循 specialist 标注。
            #   - p53→pATM（negative_feedback, inhibition）：p53 反馈抑制 ATM。
            #   - Caspase3_active→XIAP（negative_feedback, inhibition）：Caspase3
            #     切割/降解 XIAP（PMID:12042762），执行负反馈。
            _interaction = str(edge.get("interaction", "")).lower()
            k_fb = _get_param(tgt_name, "k_inhib", 0.05)
            if _interaction == "inhibition":
                # 抑制：source 抑制 target（与 inhibition handler 语义一致）
                _rate = k_fb * src * tgt
                dy[t_idx] -= _rate
            else:
                # 激活：logistic 饱和（防止无界增长）
                _max_pool = max(Y0[t_idx] if t_idx < len(Y0) else 0.1, 0.1) * 5.0
                _rate = k_fb * src * max(0.0, 1.0 - tgt / _max_pool)
                dy[t_idx] += _rate

        elif mechanism == "translocation":
            # [BENCHMARK CLOSURE / Gap-APOPTOSIS-Cyt_c-NoRelease] 修复：
            #   根因：MOMP → Cyt_c mechanism=translocation 无专用 handler，
            #   落入 else 分支（k_default=0.01 mass-action），比 cleavage/activation
            #   速率（k_cat=5.0, k_act=1.0）低 100-500x，Cyt_c 产生远慢于消耗
            #   （Cyt_c → Apaf1 activation + Cyt_c → Apoptosome complex_formation
            #   + Cyt_c → Caspase3_active activation），导致 Cyt_c 从 initial=1.0
            #   单调下降，peak_time=0.0（12-check Peak Time + Peak Order FAIL）。
            #   生物学：MOMP（线粒体外膜通透化）触发 Cyt c 从线粒体释放到胞质，
            #   是凋亡级联的关键事件（PMID:11447765）。释放速率受 MOMP 程度
            #   控制（mass-action，~0.5 min^-1，半衰期 ~1.4min）。
            #   修复：translocation = mass-action 转移（消耗 source 产生 target），
            #   k_trans=0.5（比 else 默认 0.01 高 50x，与 activation k_act=1.0 同量级）。
            k_trans = _get_param(tgt_name, "k_cat", 0.5)
            _rate = k_trans * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "tetramerization":
            # [Round 6 / RC35] 四聚化（p53 → p53_tetramer）
            # 根因：tetramerization 落入 else（mass-action 转移 k*src），无饱和，
            #   p53_tetramer 单向累积。
            # 修复：Michaelis-Menten 饱和（有限装配速率），消耗 source 产生 target。
            # 生物学依据：p53 四聚化是可逆寡聚反应，受 p53 浓度限制（PMID:9075683）。
            k_tet = _get_param(tgt_name, "k_cat", 0.1)
            Km_tet = _get_param(tgt_name, "Km", 0.1)
            _rate = k_tet * src / (Km_tet + src) if (Km_tet + src) > 0 else 0.0
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "acetylation":
            # [Round 6 / RC35] 乙酰化（p53 → p53_ac）
            # 根因：acetylation 落入 else（mass-action 转移），无去乙酰化回流，
            #   p53_ac 单向累积，source 被持续消耗无补充。
            # 修复：与 phosphorylation handler 一致 —— Michaelis-Menten + 去乙酰化
            #   （deacetylation）回流，保持质量守恒。
            # 生物学依据：p53 乙酰化由 p300/CBP 催化（PMID:10644992），
            #   去乙酰化由 HDAC/SIRT 催化（PMID:19285565），可逆共价修饰。
            k_acetyl = _get_param(tgt_name, "k_cat", 0.1)
            Km_acetyl = _get_param(tgt_name, "Km", 0.1)
            k_deacetyl = _get_param(tgt_name, "k_dephos", 0.05)
            _enzyme_conc = 0.1  # 等效 p300/CBP 激酶浓度（nM）
            _Vmax = k_acetyl * _enzyme_conc
            _rate = _Vmax * src / (Km_acetyl + src) if (Km_acetyl + src) > 0 else 0.0
            dy[s_idx] -= _rate
            dy[t_idx] += _rate
            # 去乙酰化回流（产物→底物，质量守恒）
            _deacetyl_rate = k_deacetyl * tgt
            dy[t_idx] -= _deacetyl_rate
            dy[s_idx] += _deacetyl_rate

        else:
            k_default = _get_param(tgt_name, "k", 0.01)
            _rate = k_default * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

    return dy


def detect_momp_and_bistability(t_arr, y_arr, threshold_ratio=0.5):
    """检测 MOMP point-of-no-return 与双稳态。

    判定规则：
      - 找到 Cyt c 物种（MOMP 标志）
      - 找到 Caspase3_active 物种（执行者）
      - 检查 Cyt c 释放是否早于 Caspase3 激活 5-15 min
      - 检查 Caspase3_active 是否进入高态（all-or-none）
    """
    cytc_idx = -1
    casp3_idx = -1
    for i, name in enumerate(SPECIES_NAMES):
        lower = name.lower()
        if "cyt_c" in lower or "cytc" in lower or "cytochrome_c" in lower:
            cytc_idx = i
        if "caspase3" in lower and ("active" in lower or "cleaved" in lower):
            casp3_idx = i

    result = {
        "momp_detected": cytc_idx >= 0,
        "bistable": False,
        "final_state": "UNKNOWN",
    }

    if cytc_idx >= 0:
        cytc_series = y_arr[:, cytc_idx]
        cytc_peak_time = float(t_arr[int(np.argmax(cytc_series))])
        result["cytc_peak_time"] = cytc_peak_time

    if casp3_idx >= 0:
        casp3_series = y_arr[:, casp3_idx]
        casp3_max = float(np.max(casp3_series))
        casp3_final = float(casp3_series[-1])
        casp3_peak_time = float(t_arr[int(np.argmax(casp3_series))])
        threshold = casp3_max * threshold_ratio

        if casp3_final >= threshold and casp3_max > 0:
            result["final_state"] = "ON"
            result["bistable"] = True
        elif casp3_final < threshold * 0.1:
            result["final_state"] = "OFF"
        else:
            result["final_state"] = "TRANSIENT"

        result["casp3_peak_time"] = casp3_peak_time
        result["casp3_max"] = casp3_max
        result["casp3_final"] = casp3_final

        if cytc_idx >= 0:
            time_diff = casp3_peak_time - result["cytc_peak_time"]
            result["casp3_after_cytc_minutes"] = time_diff
            result["momp_before_casp3"] = time_diff > 0

    return result


# =============================================================================
# 主程序
# =============================================================================
if __name__ == "__main__":
    # [BM 修复] Y0 全零保护：若无初始扰动则注入默认值，避免仿真输出全零
    _y0_arr = np.asarray(Y0, dtype=float)
    if np.all(_y0_arr == 0.0) and N_SP > 0:
        print("[v4] WARNING: Y0 全零，注入默认扰动（Y0[0]=1.0）以驱动仿真")
        Y0 = list(_y0_arr)
        Y0[0] = 1.0

    t_eval = np.linspace(0, T_END, N_EVAL)
    sol = solve_ivp(
        _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
        method="LSODA", max_step=MAX_STEP_MEDIUM, rtol=1e-6, atol=1e-9,
    )

    t_arr = sol.t
    y_arr = sol.y.T

    # [BM 修复] 生成 simulation.csv + simulation.png（sandbox.py 要求）
    try:
        header = "t," + ",".join(SPECIES_NAMES)
        data = np.column_stack([t_arr, y_arr])
        np.savetxt("simulation.csv", data, delimiter=",", header=header, comments="")

        fig, ax = plt.subplots(figsize=(10, 6))
        for i, sp in enumerate(SPECIES_NAMES):
            if i < y_arr.shape[1]:
                ax.plot(t_arr, y_arr[:, i], label=sp, linewidth=1.5)
        ax.set_xlabel("Time")
        ax.set_ylabel("Concentration")
        ax.set_title("Simulation")
        ax.legend(loc="upper right", fontsize=8)
        ax.grid(alpha=0.3)
        fig.tight_layout()
        fig.savefig("simulation.png", dpi=120)
        plt.close(fig)
    except Exception as _e:
        print(f"[v4] CSV/PNG 生成失败: {_e}")

    # BIO_CHECK 终态输出（sandbox 生物学检查）
    for i, sp in enumerate(SPECIES_NAMES):
        if i < y_arr.shape[1]:
            val = float(y_arr[-1, i])
            safe_val = max(val, 0.0) if np.isfinite(val) else 0.0
            print(f"BIO_CHECK: {sp} = {safe_val:.4f}")

    # BIO_CHECK: simulation_complete, n_species=N_SP, n_steps=len(t_eval)
    # BIO_CHECK: max_conc={max(y_arr[:,i]) for i in range(N_SP)}
    # BIO_CHECK: min_conc={min(y_arr[:,i]) for i in range(N_SP)}
    print(f"# BIO_CHECK: simulation_complete, n_species={N_SP}, n_steps={len(t_eval)}")
    print(f"# BIO_CHECK: max_conc={[float(np.max(y_arr[:, i])) for i in range(N_SP)]}")
    print(f"# BIO_CHECK: min_conc={[float(np.min(y_arr[:, i])) for i in range(N_SP)]}")

    momp_result = detect_momp_and_bistability(t_arr, y_arr)

    import json
    result = {
        "species_names": SPECIES_NAMES,
        "time_points": t_arr.tolist(),
        "concentrations": y_arr.tolist(),
        "momp_bistability": momp_result,
    }
    print(json.dumps(result, default=str))
