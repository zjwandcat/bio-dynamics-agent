{# v4 ODE Template: 转录延迟模板（Transcriptional Delay Template）
   对应 PART C5 + 审计 §3.2 无 DDE 支持。

   适用通路：
     - p53_signaling (p53→Mdm2 转录延迟)
     - NF_kB (NF-κB→IκBα 转录延迟)
     - TGF_beta (SMAD→SMAD7 转录延迟)
     - JAK_STAT (STAT→SOCS 转录延迟)

   与 oscillatory_feedback.j2 的差异：
     - 专注转录延迟建模（不强制振荡）
     - 支持纯延迟仿真（无反馈环也可用）
     - 多时间尺度：FAST (磷酸化) + MEDIUM (转录)

   参数：
     - SPECIES_NAMES: 物种列表
     - EDGES: 反应边列表
     - PARAMS: 每个物种的动力学参数
     - T_END: 仿真总时长（分钟）
     - DDE_DELAY: 转录延迟（分钟）
#}
"""
ODE 仿真（v4 转录延迟模板）— Transcriptional Delay Template
- 适用：p53 / NF-κB / TGF-β / JAK-STAT 等含转录延迟的通路
- 支持 DDE（jitcdde 可用时）与 ODE 降级
- 多时间尺度：FAST (磷酸化) + MEDIUM (转录/翻译)

对应审计修复：
  §3.2 无 DDE 支持 → 新增 DDE 求解
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
EDGES = {{ edges_json }}
PARAMS = {{ params_json }}
DDE_DELAY = {{ dde_delay_minutes }}
REQUIRES_DDE = {{ requires_dde | default(false) }}
PATHWAY_CLASS = "{{ pathway_class | default('') }}"

N_SP = len(SPECIES_NAMES)
SP_IDX = {name: i for i, name in enumerate(SPECIES_NAMES)}

# 多时间尺度 max_step 配置（审计 §3.6 修复）
MAX_STEP_FAST = 0.1      # 磷酸化
MAX_STEP_MEDIUM = 0.5    # 转录/翻译
MAX_STEP_SLOW = 1.0      # 降解

# TD-009 (IB-028) 修复：从 app.solvers.dde_solver 导入 DDE 求解器
# 旧实现直接 import jitcdde 但从不调用 solve_dde（死代码），现改为调用 dde_solver 模块
from app.solvers.dde_solver import solve_dde, is_dde_available
_JITCDDE_AVAILABLE = is_dde_available()


def _get_param(target_name, param_key, default):
    """从 PARAMS 中获取指定 target 的参数值。"""
    eparams = PARAMS.get(target_name, {})
    return eparams.get(param_key, default)


def _ode_rhs(t, y, y_delayed=None):
    """ODE 右端函数（转录延迟模板）。

    TD-009 修复：新增 y_delayed 可选参数支持 DDE 求解。
    - ODE 模式（y_delayed=None）：y(t-τ) ≈ y(t)，转录用当前 TF 浓度
    - DDE 模式（y_delayed 提供值）：转录使用 y_delayed（即 y(t-τ)）作为 TF 浓度
    """
    dy = np.zeros(N_SP)
    y = np.maximum(y, 0.0)  # TD-001 修复：负浓度保护（防 Hill src**n 对负底数产生 NaN）
    # TD-009 修复：DDE 模式下使用延迟状态；ODE 模式下 y_delayed = y
    if y_delayed is None:
        y_delayed = y
    else:
        y_delayed = np.maximum(y_delayed, 0.0)
    for edge in EDGES:
        src_name = edge.get("source", "")
        tgt_name = edge.get("target", "")
        mechanism = edge.get("mechanism", "activation")
        if src_name not in SP_IDX or tgt_name not in SP_IDX:
            continue
        s_idx = SP_IDX[src_name]
        t_idx = SP_IDX[tgt_name]
        src = y[s_idx]
        tgt = y[t_idx]

        if mechanism == "transcription":
            # TD-009 修复：转录使用延迟状态 y(t-τ) 作为 TF 浓度（DDE 核心延迟项）
            # DDE 模式：src_eff = y_delayed[s_idx]（τ 分钟前的 TF 浓度驱动当前 mRNA 转录）
            # ODE 模式：src_eff = y[s_idx]（y_delayed = y，退化为当前浓度）
            src_eff = y_delayed[s_idx]
            k_trans = _get_param(tgt_name, "k_trans", 0.1)
            n_hill = _get_param(tgt_name, "n_hill", 2.0)
            K_d = _get_param(tgt_name, "K_d", 0.5)
            k_mRNA_deg = _get_param(tgt_name, "k_mRNA_deg", 0.01)
            _hill = (src_eff ** n_hill) / (K_d ** n_hill + src_eff ** n_hill) if (K_d ** n_hill + src_eff ** n_hill) > 0 else 0.0
            _rate = k_trans * _hill
            dy[t_idx] += _rate
            dy[t_idx] -= k_mRNA_deg * tgt

        elif mechanism == "translation":
            k_transl = _get_param(tgt_name, "k_transl", 0.05)
            k_prot_deg = _get_param(tgt_name, "k_prot_deg", 0.005)
            _rate = k_transl * src
            dy[t_idx] += _rate
            dy[t_idx] -= k_prot_deg * tgt

        elif mechanism == "phosphorylation":
            # Michaelis-Menten（v4 恢复）
            k_cat = _get_param(tgt_name, "k_cat", 0.1)
            Km = _get_param(tgt_name, "Km", 0.1)
            k_dephos = _get_param(tgt_name, "k_dephos", 0.001)
            _Vmax = k_cat * src
            _rate = _Vmax * src / (Km + src) if (Km + src) > 0 else 0.0
            dy[s_idx] -= _rate
            dy[t_idx] += _rate
            dy[t_idx] -= k_dephos * tgt

        elif mechanism == "ubiquitination":
            k_ubi = _get_param(tgt_name, "k_ubi", 0.1)
            Km_ubi = _get_param(tgt_name, "Km_ubi", 0.5)
            _rate = k_ubi * src * tgt / (Km_ubi + tgt) if (Km_ubi + tgt) > 0 else 0.0
            dy[t_idx] -= _rate

        elif mechanism == "proteasomal_degradation":
            k_deg = _get_param(tgt_name, "k_deg", 0.01)
            _rate = k_deg * src
            dy[s_idx] -= _rate

        elif mechanism == "nuclear_import":
            k_import = _get_param(tgt_name, "k_import", 0.1)
            _rate = k_import * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "inhibition":
            k_inhib = _get_param(tgt_name, "k_inhib", 0.05)
            _rate = k_inhib * src * tgt
            dy[t_idx] -= _rate

        elif mechanism == "activation":
            k_act = _get_param(tgt_name, "k_act", 0.05)
            _rate = k_act * src
            dy[t_idx] += _rate

        else:
            k_default = _get_param(tgt_name, "k", 0.01)
            _rate = k_default * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

    return dy


def detect_delay_effect(t_arr, y_arr):
    """检测转录延迟效应。

    判定规则：
      - 找到 mRNA 物种（含 _mRNA 后缀）
      - 检查其峰值是否晚于 TF 峰值
      - 延迟显著 → delay_effective=True
    """
    tf_idx = -1
    mrna_idx = -1
    for i, name in enumerate(SPECIES_NAMES):
        if name.endswith("_mRNA") and mrna_idx < 0:
            mrna_idx = i
        elif not name.endswith("_mRNA") and tf_idx < 0:
            tf_idx = i

    if tf_idx < 0 or mrna_idx < 0:
        return {"delay_effective": False, "tf_peak_time": -1.0, "mrna_peak_time": -1.0}

    tf_series = y_arr[:, tf_idx]
    mrna_series = y_arr[:, mrna_idx]
    tf_peak_time = float(t_arr[int(np.argmax(tf_series))])
    mrna_peak_time = float(t_arr[int(np.argmax(mrna_series))])

    return {
        "delay_effective": mrna_peak_time > tf_peak_time,
        "tf_peak_time": tf_peak_time,
        "mrna_peak_time": mrna_peak_time,
        "delay_minutes": mrna_peak_time - tf_peak_time,
    }


# =============================================================================
# 主程序
# =============================================================================
if __name__ == "__main__":
    t_eval = np.linspace(0, T_END, N_EVAL)

    # TD-009 (IB-028) 修复：DDE 分支 —— 真实调用 solve_dde，不再静默降级为 ODE
    if DDE_DELAY > 0 and is_dde_available():
        # 分支1：延迟 > 0 且 DDE 可用 → 调用 solve_dde 真实 DDE 求解
        print(f"[v4] TD-009: 调用 solve_dde 真实 DDE 求解（τ={DDE_DELAY} min）")
        dde_result = solve_dde(
            rhs=_ode_rhs,
            t_span=(0, T_END),
            y0=Y0,
            delay=DDE_DELAY,
            t_eval=t_eval,
            max_step=MAX_STEP_MEDIUM,
        )
        t_arr = np.asarray(dde_result["t"])
        y_arr = np.asarray(dde_result["y"])
        _dde_used = dde_result.get("dde_used", True)
    elif DDE_DELAY > 0 and not is_dde_available():
        # 分支2：延迟 > 0 但 DDE 不可用 → 必须打印 DOWNGRADE 警告（禁止静默降级）
        print(f"[v4] TD-009 DOWNGRADE WARNING: jitcdde 不可用，"
              f"DDE 延迟 τ={DDE_DELAY} min 失效（y(t-τ)≈y(t)），降级为 ODE 求解")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=MAX_STEP_MEDIUM, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False
    else:
        # 分支3：无延迟（DDE_DELAY == 0）→ 正常 ODE 求解
        print(f"[v4] TD-009: 无延迟（DDE_DELAY=0），使用 ODE 求解")
        sol = solve_ivp(
            _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
            method="LSODA", max_step=MAX_STEP_MEDIUM, rtol=1e-6, atol=1e-9,
        )
        t_arr = sol.t
        y_arr = sol.y.T
        _dde_used = False

    # BIO_CHECK: simulation_complete, n_species=N_SP, n_steps=len(t_eval)
    # BIO_CHECK: max_conc={max(y_arr[:,i]) for i in range(N_SP)}
    # BIO_CHECK: min_conc={min(y_arr[:,i]) for i in range(N_SP)}
    print(f"# BIO_CHECK: simulation_complete, n_species={N_SP}, n_steps={len(t_eval)}")
    print(f"# BIO_CHECK: max_conc={[float(np.max(y_arr[:, i])) for i in range(N_SP)]}")
    print(f"# BIO_CHECK: min_conc={[float(np.min(y_arr[:, i])) for i in range(N_SP)]}")

    delay_result = detect_delay_effect(t_arr, y_arr)

    import json
    result = {
        "species_names": SPECIES_NAMES,
        "time_points": t_arr.tolist(),
        "concentrations": y_arr.tolist(),
        "dde_delay_minutes": DDE_DELAY,
        # TD-009 修复：使用 _dde_used 反映实际求解方式（True=真实 DDE，False=ODE 降级）
        "dde_available": _JITCDDE_AVAILABLE,
        "dde_used": _dde_used,
        "requires_dde": REQUIRES_DDE,
        "delay_effect": delay_result,
    }
    print(json.dumps(result, default=str))
