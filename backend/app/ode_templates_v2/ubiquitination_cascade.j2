{# v4 ODE Template: 泛素化级联模板（Ubiquitination Cascade Template）
   对应 PART C5 + 审计 §4.1 缺 ubiquitination。

   适用通路：
     - p53_signaling (p53-Mdm2 泛素化)
     - NF_kB (IκBα 泛素化)
     - Wnt (β-catenin 泛素化)

   关键特性：
     1. 磷酸化依赖的泛素化（phosphorylation → ubiquitination → degradation）
     2. 三步耦合：磷酸化 → 泛素化 → 蛋白酶体降解
     3. E3 连接酶动力学（Michaelis-Menten）

   参数：
     - SPECIES_NAMES: 物种列表
     - EDGES: 反应边列表
     - PARAMS: 每个物种的动力学参数
     - T_END: 仿真总时长（分钟）
#}
"""
ODE 仿真（v4 泛素化级联模板）— Ubiquitination Cascade Template
- 适用：p53-Mdm2 / IκBα-β-TrCP / β-catenin 等泛素化通路
- 磷酸化依赖的泛素化三步耦合
- E3 连接酶 Michaelis-Menten 动力学

对应审计修复：
  §4.1 缺 ubiquitination → 新增泛素化机制
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
EDGES = {{ edges_json }}
PARAMS = {{ params_json }}
DDE_DELAY = {{ dde_delay_minutes }}
REQUIRES_DDE = {{ requires_dde | default(false) }}
PATHWAY_CLASS = "{{ pathway_class | default('') }}"

N_SP = len(SPECIES_NAMES)
SP_IDX = {name: i for i, name in enumerate(SPECIES_NAMES)}

MAX_STEP_FAST = 0.1
MAX_STEP_MEDIUM = 0.5


def _get_param(target_name, param_key, default):
    """从 PARAMS 中获取指定 target 的参数值。"""
    eparams = PARAMS.get(target_name, {})
    return eparams.get(param_key, default)


def _ode_rhs(t, y):
    """ODE 右端函数（泛素化级联模板）。"""
    dy = np.zeros(N_SP)
    for edge in EDGES:
        src_name = edge.get("source", "")
        tgt_name = edge.get("target", "")
        mechanism = edge.get("mechanism", "activation")
        if src_name not in SP_IDX or tgt_name not in SP_IDX:
            continue
        s_idx = SP_IDX[src_name]
        t_idx = SP_IDX[tgt_name]
        src = y[s_idx]
        tgt = y[t_idx]

        if mechanism == "ubiquitination":
            # 泛素化（E3 连接酶 Michaelis-Menten）
            # v = k_ubi * [E3] * [substrate] / (Km_ubi + [substrate])
            k_ubi = _get_param(tgt_name, "k_ubi", 0.1)
            Km_ubi = _get_param(tgt_name, "Km_ubi", 0.5)
            _rate = k_ubi * src * tgt / (Km_ubi + tgt) if (Km_ubi + tgt) > 0 else 0.0
            dy[t_idx] -= _rate  # 底物消耗（被泛素化）
            # 泛素化产物生成（如果有 Ub_ 前缀的物种）
            ub_name = "Ub_" + tgt_name
            if ub_name in SP_IDX:
                dy[SP_IDX[ub_name]] += _rate

        elif mechanism == "phosphorylation":
            # Michaelis-Menten（磷酸化依赖的泛素化前置）
            k_cat = _get_param(tgt_name, "k_cat", 0.1)
            Km = _get_param(tgt_name, "Km", 0.1)
            k_dephos = _get_param(tgt_name, "k_dephos", 0.001)
            _Vmax = k_cat * src
            _rate = _Vmax * src / (Km + src) if (Km + src) > 0 else 0.0
            dy[s_idx] -= _rate
            dy[t_idx] += _rate
            dy[t_idx] -= k_dephos * tgt

        elif mechanism == "proteasomal_degradation":
            # 蛋白酶体降解（泛素化依赖，一级动力学）
            k_deg = _get_param(tgt_name, "k_deg", 0.01)
            _rate = k_deg * src
            dy[s_idx] -= _rate

        elif mechanism == "degradation":
            # 通用降解（一级）
            k_deg = _get_param(tgt_name, "k_deg", 0.005)
            _rate = k_deg * src
            dy[s_idx] -= _rate

        elif mechanism == "transcription":
            k_trans = _get_param(tgt_name, "k_trans", 0.1)
            n_hill = _get_param(tgt_name, "n_hill", 2.0)
            K_d = _get_param(tgt_name, "K_d", 0.5)
            k_mRNA_deg = _get_param(tgt_name, "k_mRNA_deg", 0.01)
            _hill = (src ** n_hill) / (K_d ** n_hill + src ** n_hill) if (K_d ** n_hill + src ** n_hill) > 0 else 0.0
            _rate = k_trans * _hill
            dy[t_idx] += _rate
            dy[t_idx] -= k_mRNA_deg * tgt

        elif mechanism == "translation":
            k_transl = _get_param(tgt_name, "k_transl", 0.05)
            k_prot_deg = _get_param(tgt_name, "k_prot_deg", 0.005)
            _rate = k_transl * src
            dy[t_idx] += _rate
            dy[t_idx] -= k_prot_deg * tgt

        elif mechanism == "binding":
            # 结合（mass-action）
            k_bind = _get_param(tgt_name, "k_bind", 0.1)
            _rate = k_bind * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

        elif mechanism == "inhibition":
            k_inhib = _get_param(tgt_name, "k_inhib", 0.05)
            _rate = k_inhib * src * tgt
            dy[t_idx] -= _rate

        elif mechanism == "activation":
            k_act = _get_param(tgt_name, "k_act", 0.05)
            _rate = k_act * src
            dy[t_idx] += _rate

        else:
            k_default = _get_param(tgt_name, "k", 0.01)
            _rate = k_default * src
            dy[s_idx] -= _rate
            dy[t_idx] += _rate

    return dy


def detect_ubiquitination_cascade(t_arr, y_arr):
    """检测泛素化级联效应。

    判定规则：
      - 找到 Ub_ 前缀的泛素化物种
      - 检查其峰值时间是否晚于磷酸化峰值
      - 底物（未泛素化）应随时间下降
    """
    ub_indices = [i for i, name in enumerate(SPECIES_NAMES) if name.startswith("Ub_")]
    p_indices = [i for i, name in enumerate(SPECIES_NAMES) if name.startswith("p")]

    result = {
        "has_ubiquitination": len(ub_indices) > 0,
        "ub_species": [SPECIES_NAMES[i] for i in ub_indices],
    }

    if ub_indices:
        ub_idx = ub_indices[0]
        ub_series = y_arr[:, ub_idx]
        ub_peak_time = float(t_arr[int(np.argmax(ub_series))])
        ub_peak = float(np.max(ub_series))
        result["ub_peak_time"] = ub_peak_time
        result["ub_peak_value"] = ub_peak

    if p_indices:
        p_idx = p_indices[0]
        p_series = y_arr[:, p_idx]
        p_peak_time = float(t_arr[int(np.argmax(p_series))])
        result["p_peak_time"] = p_peak_time
        if ub_indices:
            result["cascade_order_correct"] = ub_peak_time >= p_peak_time

    return result


# =============================================================================
# 主程序
# =============================================================================
if __name__ == "__main__":
    t_eval = np.linspace(0, T_END, N_EVAL)
    sol = solve_ivp(
        _ode_rhs, [0, T_END], Y0, t_eval=t_eval,
        method="LSODA", max_step=MAX_STEP_MEDIUM, rtol=1e-6, atol=1e-9,
    )

    t_arr = sol.t
    y_arr = sol.y.T

    # BIO_CHECK: simulation_complete, n_species=N_SP, n_steps=len(t_eval)
    # BIO_CHECK: max_conc={max(y_arr[:,i]) for i in range(N_SP)}
    # BIO_CHECK: min_conc={min(y_arr[:,i]) for i in range(N_SP)}
    print(f"# BIO_CHECK: simulation_complete, n_species={N_SP}, n_steps={len(t_eval)}")
    print(f"# BIO_CHECK: max_conc={[float(np.max(y_arr[:, i])) for i in range(N_SP)]}")
    print(f"# BIO_CHECK: min_conc={[float(np.min(y_arr[:, i])) for i in range(N_SP)]}")

    cascade_result = detect_ubiquitination_cascade(t_arr, y_arr)

    import json
    result = {
        "species_names": SPECIES_NAMES,
        "time_points": t_arr.tolist(),
        "concentrations": y_arr.tolist(),
        "ubiquitination_cascade": cascade_result,
    }
    print(json.dumps(result, default=str))
