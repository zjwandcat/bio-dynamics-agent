"""
ODE 仿真（PKPD_TwoCompartment 模板）
- 2-房室 PK + Emax 效应
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
DRUG_NAME = "{{ drug_name }}"
DOSE = {{ dose }}
K10 = {{ k10 }}
K12 = {{ k12 }}
K21 = {{ k21 }}
TARGET = "{{ target }}"
EC50 = {{ ec50 }}
EMAX = {{ emax }}
GAMMA = {{ gamma }}
# [Batch 3 / LLM_PARAM_INFERENCE_PLAN.md §5.3] 原 0.5*(1-effect)-0.05*target 硬编码改为可覆盖
#   Flag OFF 时 default 等价 r40（与 PKPD_OneCompartment.j2 改造保持一致）
K_PROD = {{ k_prod | default(0.5) }}
K_DEG = {{ k_deg | default(0.05) }}

def _ode(t, y):
    c_central, peripheral, target = y
    effect = EMAX * (c_central ** GAMMA) / (EC50 ** GAMMA + c_central ** GAMMA + 1e-12)
    d_c = -K10 * c_central - K12 * c_central + K21 * peripheral
    d_p = K12 * c_central - K21 * peripheral
    d_target = K_PROD * (1.0 - effect) - K_DEG * target
    return [d_c, d_p, d_target]

init = [DOSE, 0.0, Y0[2] if len(Y0) > 2 else 0.0]
sol = solve_ivp(
    _ode,
    (0.0, T_END),
    init,
    method="LSODA",
    t_eval=np.linspace(0.0, T_END, N_EVAL),
    vectorized=False,
)

header = "t," + ",".join(SPECIES_NAMES)
data = np.column_stack([sol.t, *sol.y])
np.savetxt("simulation.csv", data, delimiter=",", header=header, comments="")

fig, ax = plt.subplots(2, 1, figsize=(8, 8))
ax[0].plot(sol.t, sol.y[0], label=f"{DRUG_NAME} central", linewidth=2, color="C0")
ax[0].plot(sol.t, sol.y[1], label=f"{DRUG_NAME} peripheral", linewidth=2, color="C2")
ax[0].set_ylabel("Drug (nM)")
ax[0].set_title(f"PK/PD 2-Compartment: {DRUG_NAME}")
ax[0].legend()
ax[0].grid(alpha=0.3)

ax[1].plot(sol.t, sol.y[2], label=TARGET, linewidth=2, color="C1")
ax[1].set_xlabel("Time (h)")
ax[1].set_ylabel(f"{TARGET} (nM)")
ax[1].legend()
ax[1].grid(alpha=0.3)

fig.tight_layout()
fig.savefig("simulation.png", dpi=120)

for i, sp in enumerate(SPECIES_NAMES):
    val = sol.y[i, -1]
    safe_val = max(val, 0.0) if np.isfinite(val) else 0.0
    print(f"BIO_CHECK: {sp} = {safe_val:.4f}")
