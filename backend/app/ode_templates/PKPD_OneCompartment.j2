"""
ODE 仿真（PKPD_OneCompartment 模板）
- 1-房室 PK + Emax 效应
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
DRUG_NAME = "{{ drug_name }}"
DOSE = {{ dose }}
K10 = {{ k10 }}
TARGET = "{{ target }}"
EC50 = {{ ec50 }}
EMAX = {{ emax }}
GAMMA = {{ gamma }}

def _ode(t, y):
    drug_conc, target = y
    effect = EMAX * (drug_conc ** GAMMA) / (EC50 ** GAMMA + drug_conc ** GAMMA + 1e-12)
    d_drug = -K10 * drug_conc
    d_target = 0.5 * (1.0 - effect) - 0.05 * target
    return [d_drug, d_target]

sol = solve_ivp(
    _ode,
    (0.0, T_END),
    [DOSE, Y0[1] if len(Y0) > 1 else 0.0],
    method="LSODA",
    t_eval=np.linspace(0.0, T_END, N_EVAL),
    vectorized=False,
)

header = "t," + ",".join(SPECIES_NAMES)
data = np.column_stack([sol.t, *sol.y])
np.savetxt("simulation.csv", data, delimiter=",", header=header, comments="")

fig, ax = plt.subplots(2, 1, figsize=(8, 8))
ax[0].plot(sol.t, sol.y[0], label=f"{DRUG_NAME} (nM)", linewidth=2, color="C0")
ax[0].set_ylabel("Drug (nM)")
ax[0].set_title(f"PK/PD 1-Compartment: {DRUG_NAME}")
ax[0].legend()
ax[0].grid(alpha=0.3)

ax[1].plot(sol.t, sol.y[1], label=TARGET, linewidth=2, color="C1")
ax[1].set_xlabel("Time (h)")
ax[1].set_ylabel(f"{TARGET} (nM)")
ax[1].legend()
ax[1].grid(alpha=0.3)

fig.tight_layout()
fig.savefig("simulation.png", dpi=120)

for i, sp in enumerate(SPECIES_NAMES):
    val = sol.y[i, -1]
    safe_val = max(val, 0.0) if np.isfinite(val) else 0.0
    print(f"BIO_CHECK: {sp} = {safe_val:.4f}")
