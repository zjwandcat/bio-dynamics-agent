"""
ODE 仿真（Simple Inhibition 模板）
- 单条抑制边
- 必须 emit：simulation.csv + simulation.png + BIO_CHECK 行
"""
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams["font.family"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False
from scipy.integrate import solve_ivp

# ====== 模板注入：参数、初值、变量名 ======
SPECIES_NAMES = {{ species_names }}
T_END = {{ t_end }}
N_EVAL = {{ n_eval }}
Y0 = {{ y0 }}
INHIBITOR = "{{ inhibitor }}"
TARGET = "{{ target }}"
KD = {{ kd }}
N_HILL = {{ n_hill }}
DEGRADATION = {{ degradation }}
PROD_RATE = {{ production }}
# [Batch 3] 原 -0.1 * inhibitor 硬编码改为可覆盖（Flag OFF 时 default=0.1 等价 r40）
K_CLEARANCE = {{ k_clearance | default(0.1) }}

# ====== ODE 系统 ======
def _ode(t, y):
    inhibitor, target = y
    # 抑制分数 inhibition ∈ [0,1]：0=无药（无抑制），1=高浓度（全抑制）
    # 与 PKPD 模板及 NODE2_PKPD_SECTION 约定一致（Task G 统一抑制项约定）
    inhibition = inhibitor ** N_HILL / (KD ** N_HILL + inhibitor ** N_HILL + 1e-12)
    d_inhibitor = -K_CLEARANCE * inhibitor
    # 强制耦合：抑制降低靶点生成率（Task G）
    d_target = PROD_RATE * (1.0 - inhibition) - DEGRADATION * target
    return [d_inhibitor, d_target]

# ====== 数值积分 ======
sol = solve_ivp(
    _ode,
    (0.0, T_END),
    Y0,
    method="LSODA",
    t_eval=np.linspace(0.0, T_END, N_EVAL),
    vectorized=False,
)

# ====== CSV 输出 ======
header = "t," + ",".join(SPECIES_NAMES)
data = np.column_stack([sol.t, *sol.y])
np.savetxt("simulation.csv", data, delimiter=",", header=header, comments="")

# ====== Plot ======
fig, ax = plt.subplots(figsize=(8, 5))
for i, name in enumerate(SPECIES_NAMES):
    ax.plot(sol.t, sol.y[i], label=name, linewidth=2)
ax.set_xlabel("Time (h)")
ax.set_ylabel("Concentration (nM)")
ax.set_title("Simple Inhibition Simulation")
ax.legend()
ax.grid(alpha=0.3)
fig.tight_layout()
fig.savefig("simulation.png", dpi=120)

# ====== BIO_CHECK ======
for i, sp in enumerate(SPECIES_NAMES):
    val = sol.y[i, -1]
    safe_val = max(val, 0.0) if np.isfinite(val) else 0.0
    print(f"BIO_CHECK: {sp} = {safe_val:.4f}")
